{
  "version": "1.0.0",
  "default_commit_backend": "agy",
  "daemon": {
    "auto_wake": {
      "enabled": false,
      "time": "04:00",
      "auto_resuspend": true,
      "resuspend_delay_seconds": 12,
      "max_wake_window_minutes": 15
    },
    "active_hours": {
      "start": "03:55",
      "end": "22:00"
    },
    "reset_alert_lead_minutes": 5,
    "desktop_notifications": true,
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "chat_id": ""
    }
  },
  "targets": [
    {
      "id": "gemini",
      "name": "Google Gemini (Antigravity)",
      "tool": "agy",
      "account": "default",
      "enabled": true,
      "telemetry_type": "agy_usage",
      "bucket_id": "gemini-5h",
      "wake_command": [
        "agy",
        "-p",
        "Reply with: 1",
        "--model",
        "gemini-3.8-flash-low",
        "--effort",
        "low"
      ],
      "status_command": [
        "agy",
        "-p",
        "/usage",
        "--output-format",
        "json"
      ],
      "fallback_interval_hours": 5,
      "timeout_sec": 20
    },
    {
      "id": "claude-gpt-agy",
      "name": "Claude & GPT (Antigravity)",
      "tool": "agy",
      "account": "default",
      "enabled": true,
      "telemetry_type": "agy_usage",
      "bucket_id": "3p-5h",
      "wake_command": [
        "agy",
        "-p",
        "Reply with: 1",
        "--model",
        "claude-sonnet-5-5-low",
        "--effort",
        "low"
      ],
      "status_command": [
        "agy",
        "-p",
        "/usage",
        "--output-format",
        "json"
      ],
      "fallback_interval_hours": 5,
      "timeout_sec": 25
    },
    {
      "id": "claude-cli",
      "name": "Anthropic Claude Code CLI",
      "tool": "claude",
      "account": "default",
      "enabled": false,
      "telemetry_type": "claude_status",
      "wake_command": [
        "claude",
        "-p",
        "Reply with: 1"
      ],
      "status_command": [
        "claude",
        "status",
        "--json"
      ],
      "fallback_interval_hours": 5,
      "timeout_sec": 25
    },
    {
      "id": "codex-cli",
      "name": "OpenAI Codex CLI",
      "tool": "codex",
      "account": "default",
      "enabled": false,
      "telemetry_type": "timed_fallback",
      "wake_command": [
        "codex",
        "exec",
        "echo 1"
      ],
      "status_command": [],
      "fallback_interval_hours": 5,
      "timeout_sec": 20
    },
    {
      "id": "opencode-cli",
      "name": "OpenCode CLI",
      "tool": "opencode",
      "account": "default",
      "enabled": false,
      "telemetry_type": "timed_fallback",
      "wake_command": [
        "opencode",
        "run",
        "echo 1"
      ],
      "status_command": [],
      "fallback_interval_hours": 5,
      "timeout_sec": 20
    },
    {
      "id": "pi-cli",
      "name": "Inflection Pi CLI",
      "tool": "pi",
      "account": "default",
      "enabled": false,
      "telemetry_type": "timed_fallback",
      "wake_command": [
        "pi",
        "ask",
        "hi"
      ],
      "status_command": [],
      "fallback_interval_hours": 5,
      "timeout_sec": 20
    },
    {
      "id": "llm-datasette",
      "name": "Datasette LLM CLI",
      "tool": "llm",
      "account": "default",
      "enabled": false,
      "telemetry_type": "timed_fallback",
      "wake_command": [
        "llm",
        "prompt",
        "1"
      ],
      "status_command": [],
      "fallback_interval_hours": 5,
      "timeout_sec": 15
    }
  ]
}
