def main() -> None:
    # Fast-path: Check for direct custom command invocation (e.g. `aitools review`)
    known_subcommands = {
        "quota", "watch", "wake", "commit", "pr", "llm", "optimize", "sysopt",
        "backends", "daemon", "status", "config", "setup", "run", "commands",
        "-v", "--version", "-h", "--help"
    }

    if len(sys.argv) > 1 and sys.argv[1] not in known_subcommands and not sys.argv[1].startswith("-"):
        cfg = load_config()
        custom_cmds = cfg.get("commands", {})
        cand = sys.argv[1]
        if cand in custom_cmds:
            execute_custom_command(cand, custom_cmds[cand], sys.argv[2:])
            return

    parser = argparse.ArgumentParser(
        prog="aitools",
        description="aitools: AI Productivity, Quota Management & Automated Workflows Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

