def query_llm(
    prompt: str,
    backend: str = None,
    model: str = None,
    effort: str = None,
    timeout_sec: int = None,
    clean_markdown_fence: bool = True,
    mode: str = None,
    output_format: str = None,
    system_prompt: str = None
) -> str:
    """
    Dispatches a prompt to an AI harness using the HarnessAdapter pattern.
    Normalizes input delivery (arg, stdin, temp_file) and output capture (stdout, temp_file, json).
    Supports execution modes (chat, action, agent) and output formats (text, json, raw).
    """
    config = load_config()
    llm_cfg = config.get("llm", {})

    eff_backend = backend or llm_cfg.get("default_backend") or config.get("default_commit_backend", "agy")
    eff_model = model or llm_cfg.get("default_model")
    eff_effort = effort or llm_cfg.get("default_effort", "low")
    eff_timeout = timeout_sec or llm_cfg.get("timeout_sec", 60)
    eff_mode = mode or llm_cfg.get("default_mode", "agent")
    eff_format = output_format or llm_cfg.get("default_output_format", "text")

    adapter = resolve_backend_adapter(eff_backend, config)

    # Check availability and apply intelligent fallback if preferred backend is missing
    if not adapter.is_available():
        fallbacks = ["agy", "llm", "claude", "codex", "opencode", "pi", "ollama"]
        found = None
        for fb in fallbacks:
            if fb == adapter.name:
                continue
            try:
                fb_adapter = resolve_backend_adapter(fb, config)
                if fb_adapter.is_available():
                    found = fb_adapter
                    break
            except Exception:
                continue

        if found:
            print(f"{C_YELLOW}⚠ Backend '{adapter.name}' not found in PATH; falling back to '{found.name}'{C_RESET}", file=sys.stderr)
            adapter = found
        else:
            bin_name = adapter.command[0] if adapter.command else adapter.name
            raise RuntimeError(
                f"AI harness '{adapter.name}' binary ('{bin_name}') was not found in PATH, and no fallback CLI tools were detected."
            )

    return adapter.execute(
        prompt=prompt,
        model=eff_model,
        effort=eff_effort,
        timeout_sec=eff_timeout,
        clean_markdown_fence=clean_markdown_fence,
        mode=eff_mode,
        output_format=eff_format,
        system_prompt=system_prompt
    )


def is_binary_file(filepath: str) -> bool:
    """Checks whether a file appears to be binary by checking for null bytes in initial chunk."""
    try:
        with open(filepath, "rb") as f:
            chunk = f.read(1024)
            return b"\0" in chunk
    except Exception:
        return True


def build_context_from_paths(
    file_paths: list[str] | None,
    dir_paths: list[str] | None,
    max_total_bytes: int = 500000,
    max_file_bytes: int = 100000
) -> str:
    """
    Collects contents and tree representations of attached files and directories.
    Respects common exclusion patterns (.git, node_modules, vendor, etc.) and size limits.
    """
    excluded_dirs = {
        ".git", "node_modules", ".pnpm-store", "vendor", "__pycache__",
        ".venv", "venv", "target", "dist", "build", ".cache", ".idea",
        ".vscode", ".gemini", ".next", ".nuxt", ".artifacts"
    }
    excluded_extensions = {
        ".png", ".jpg", ".jpeg", ".gif", ".ico", ".pdf", ".zip", ".tar",
        ".gz", ".7z", ".exe", ".bin", ".pyc", ".iso", ".so", ".dylib",
        ".dll", ".wasm", ".zwc"
    }

    sections: list[str] = []
    total_bytes = 0

    # 1. Process individual file attachments
    if file_paths:
        for f_path in file_paths:
            exp_path = os.path.expanduser(f_path)
            if not os.path.exists(exp_path):
                sections.append(f"=== Attached File: {f_path} (NOT FOUND) ===\n[File does not exist]\n")
                continue
            if os.path.isdir(exp_path):
                dir_paths = list(dir_paths or []) + [f_path]
                continue
            if is_binary_file(exp_path):
                sections.append(f"=== Attached File: {f_path} (BINARY) ===\n[Binary file omitted]\n")
                continue

            try:
                size = os.path.getsize(exp_path)
                with open(exp_path, "r", encoding="utf-8", errors="replace") as f:
                    content = f.read(max_file_bytes)
                    if size > max_file_bytes:
                        content += f"\n... [File truncated at {max_file_bytes} bytes]"
                total_bytes += len(content.encode("utf-8"))
                sections.append(f"=== Attached File: {f_path} ===\n{content}\n")
            except Exception as e:
                sections.append(f"=== Attached File: {f_path} (ERROR) ===\n[Error reading file: {e}]\n")

            if total_bytes >= max_total_bytes:
                sections.append(f"... [Context limit of {max_total_bytes} bytes reached, remaining attachments omitted]\n")
                return "\n".join(sections)

    # 2. Process directory attachments
    if dir_paths:
        for d_path in dir_paths:
            exp_path = os.path.expanduser(d_path)
            if not os.path.exists(exp_path):
                sections.append(f"=== Attached Directory: {d_path} (NOT FOUND) ===\n[Directory does not exist]\n")
                continue
            if not os.path.isdir(exp_path):
                continue

            dir_tree_lines: list[str] = []
            files_to_read: list[str] = []

            for root, dirs, files in os.walk(exp_path):
                dirs[:] = [d for d in sorted(dirs) if d not in excluded_dirs and not d.startswith(".")]
                rel_root = os.path.relpath(root, exp_path)
                depth = 0 if rel_root == "." else rel_root.count(os.sep) + 1
                indent = "  " * depth

                base_name = os.path.basename(root) if rel_root != "." else os.path.basename(os.path.abspath(exp_path))
                dir_tree_lines.append(f"{indent}📁 {base_name}/")

                for file in sorted(files):
                    ext = os.path.splitext(file)[1].lower()
                    if file.startswith(".") or ext in excluded_extensions:
                        continue
                    file_full = os.path.join(root, file)
                    dir_tree_lines.append(f"{indent}  📄 {file}")
                    if len(files_to_read) < 50:
                        files_to_read.append(file_full)

            sections.append(f"=== Directory Tree: {d_path} ===\n" + "\n".join(dir_tree_lines[:100]) + "\n")

            for f_full in files_to_read:
                if total_bytes >= max_total_bytes:
                    sections.append(f"... [Context limit of {max_total_bytes} bytes reached, remaining files omitted]\n")
                    break
                if is_binary_file(f_full):
                    continue
                try:
                    rel_to_cwd = os.path.relpath(f_full)
                    with open(f_full, "r", encoding="utf-8", errors="replace") as f:
                        file_content = f.read(max_file_bytes // 2)
                    total_bytes += len(file_content.encode("utf-8"))
                    sections.append(f"=== File: {rel_to_cwd} ===\n{file_content}\n")
                except Exception:
                    continue

    return "\n".join(sections).strip()


def run_llm_cli(args) -> None:
    """CLI handler for `aitools llm` subcommand (Unified Non-Interactive Harness Wrapper)."""
    if getattr(args, "list_backends", False):
        show_backends()
        return

    config = load_config()
    llm_cfg = config.get("llm", {})

    backend = args.backend or llm_cfg.get("default_backend") or config.get("default_commit_backend", "agy")
    model = args.model or llm_cfg.get("default_model")
    effort = args.effort or llm_cfg.get("default_effort", "low")
    mode = (args.mode or llm_cfg.get("default_mode", "agent")).lower()
    output_format = (args.output_format or llm_cfg.get("default_output_format", "text")).lower()
    timeout_sec = args.timeout if args.timeout is not None else llm_cfg.get("timeout_sec", 60)
    clean_markdown = not args.no_clean_markdown if hasattr(args, "no_clean_markdown") else True
    system_prompt = getattr(args, "system", None)

    stdin_data = ""
    if not sys.stdin.isatty():
        try:
            stdin_data = sys.stdin.read().strip()
        except Exception:
            stdin_data = ""

    cli_prompt = " ".join(args.prompt).strip() if args.prompt else ""
    context_data = build_context_from_paths(args.file, args.dir)

    prompt_parts = []
    if context_data:
        prompt_parts.append(context_data)
    if stdin_data:
        prompt_parts.append(f"=== Standard Input ===\n{stdin_data}" if (context_data or cli_prompt) else stdin_data)
    if cli_prompt:
        prompt_parts.append(f"=== Instruction ===\n{cli_prompt}" if (context_data or stdin_data) else cli_prompt)

    final_prompt = "\n\n".join(prompt_parts).strip()

    if not final_prompt:
        print(f"{C_RED}[ERROR] No prompt or input provided.{C_RESET}", file=sys.stderr)
        print("Usage examples:", file=sys.stderr)
        print("  aitools llm 'Explain Python GIL' -b agy", file=sys.stderr)
        print("  cat error.log | aitools llm 'Find root cause' -m gemini-2.5-flash", file=sys.stderr)
        print("  aitools llm 'Review code' -f main.py -d src/ --mode chat", file=sys.stderr)
        sys.exit(1)

    try:
        result = query_llm(
            prompt=final_prompt,
            backend=backend,
            model=model,
            effort=effort,
            timeout_sec=timeout_sec,
            clean_markdown_fence=clean_markdown,
            mode=mode,
            output_format=output_format,
            system_prompt=system_prompt
        )

        out_file = getattr(args, "output_file", None)
        if out_file:
            os.makedirs(os.path.dirname(os.path.abspath(out_file)), exist_ok=True)
            with open(out_file, "w", encoding="utf-8") as f:
                f.write(result + "\n")
            print(f"{C_GREEN}✓ Output written to {out_file}{C_RESET}")
        else:
            print(result)

    except Exception as e:
        if output_format == "json":
            err_envelope = {
                "backend": backend,
                "status": "error",
                "error": str(e)
            }
            print(json.dumps(err_envelope, indent=2))
        else:
            print(f"{C_RED}[ERROR] {e}{C_RESET}", file=sys.stderr)
        sys.exit(1)


def get_git_diff(stage_all: bool = False) -> tuple[str, bool]:
    # Check if inside git repo
    res = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True)
    if res.returncode != 0:
        return "", False

    if stage_all:
        subprocess.run(["git", "add", "-u"], check=False)

    # Check staged changes
    res_staged = subprocess.run(["git", "diff", "--cached"], capture_output=True, text=True)
    staged_diff = res_staged.stdout

    if staged_diff.strip():
        return staged_diff, True

    # If no staged changes, check unstaged
    res_unstaged = subprocess.run(["git", "diff"], capture_output=True, text=True)
    unstaged_diff = res_unstaged.stdout

    if unstaged_diff.strip():
        print(f"{C_YELLOW}⚠ No staged changes found, but unstaged modifications exist.{C_RESET}")
        choice = input("  Stage all tracked modified files (git add -u)? [Y/n]: ").strip().lower()
        if choice in ("", "y", "yes"):
            subprocess.run(["git", "add", "-u"], check=False)
            res_cached = subprocess.run(["git", "diff", "--cached"], capture_output=True, text=True)
            return res_cached.stdout, True

    return "", False


def get_git_branch() -> str:
    """Returns current git branch name or empty string if not in git repository."""
    try:
        res = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, check=False
        )
        if res.returncode == 0:
            branch = res.stdout.strip()
            if branch != "HEAD":
                return branch
    except Exception:
        pass
    return ""


def extract_task_id(branch_name: str) -> str:
    """Extracts task or issue ticket ID (e.g. PROJ-1234, ENG-42, #123, issue-456) from a branch name."""
    if not branch_name:
        return ""
    # 1. Standard project key format (e.g. PROJ-1234, ABC-9)
    match_key = re.search(r'([A-Za-z]{2,10}-[0-9]+)', branch_name)
    if match_key:
        return match_key.group(1).upper()
    # 2. Issue/ticket number format (e.g. issue/123, feat/#42, ticket-789)
    match_num = re.search(r'(?:issue|ticket|task|bug|fix|feat|gh)?[-/#]([0-9]{1,7})(?:[-_]|$)', branch_name, re.IGNORECASE)
    if match_num and match_num.group(1):
        return f"#{match_num.group(1)}"
    return ""


