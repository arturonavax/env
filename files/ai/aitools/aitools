def run_system_optimize(args: argparse.Namespace) -> None:
    """Execute the multi-platform system optimization and hardware audit engine."""
    repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".."))
    script_path = os.path.join(repo_root, "utils", "optimize_system.sh")
    if not os.path.isfile(script_path):
