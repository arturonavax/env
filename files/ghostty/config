# --- Dimensiones y Estado ---
window-width = 150
window-height = 43
# window-save-state = "always"

# --- Tipografía ---
font-family = "MonaspiceNe Nerd Font Mono"
font-size = 13

# --- Apariencia ---
theme = "light:TokyoNight Day,dark:TokyoNight Night"

background-opacity = 0.97
background-blur-radius = 0

window-decoration = true
window-padding-balance = true
# window-colorspace = "display-p3" # Exclusivo de macOS (Metal Wide Color)

# Ajuste de grises para comentarios y texto secundario
palette = 8=#808080
palette = 0=#404040

# --- Rendimiento y Comportamiento ---
gtk-single-instance = false
mouse-hide-while-typing = true
auto-update = "off"
gtk-titlebar = false
cursor-style = block
cursor-style-blink = false
font-feature = []
window-vsync = true

# --- Inicio automático con Herdr ---
copy-on-select = clipboard
# Reducir eventos de scroll emitidos por tick/touchpad (default: 3)
mouse-scroll-multiplier = 1

command = zsh -ic "herdr"

desktop-notifications = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 3s
