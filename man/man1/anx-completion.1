.TH "ANX" "1" "Oct 2026" "anx 1.0.0" "Anx User Manual"

.SH NAME
anx-completion - Generate or install shell completion script


.SH SYNOPSIS
\fBanx completion  [flags]\fP


.SH DESCRIPTION
Generate or install automatic completion scripts for bash, zsh, fish, or powershell.

.PP
Pass --install to write the completion file directly to your shell's user completion path.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for completion

.PP
\fB--install\fP[=false]
	Install completion script into user shell completions directory


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--dry-run\fP[=false]
	Preview actions without mutating the system

.PP
\fB--format\fP="text"
	Output format (text|json|yaml)

.PP
\fB--include-hacks\fP[=false]
	Include matched hardware workstation hacks during apply

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	Force interactive prompts

.PP
\fB--no-color\fP[=false]
	Disable ANSI color rendering

.PP
\fB--offline\fP[=false]
	Disable network queries

.PP
\fB--profile\fP="developer"
	Target profile name

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--theme\fP="tokyo-night"
	UI theme (see 'anx theme list')

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose execution logging

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Automatically answer yes to confirmations


.SH EXAMPLE
.EX
  # Load zsh completion in current shell
  source <(anx completion zsh)

  # Permanently install zsh completion for current user
  anx completion zsh --install

  # Install bash completion
  anx completion bash --install
.EE


.SH SEE ALSO
\fBanx(1)\fP


