ANSI_ESCAPE_RE = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')


def strip_ansi_codes(text: str) -> str:
    """Strips ANSI terminal escape sequences, carriage returns, and terminal control chars."""
    if not text:
        return ""
    clean = ANSI_ESCAPE_RE.sub('', text)
    clean = clean.replace('\r', '')
    return clean.strip()


def extract_json_path(data: any, path_str: str) -> any:
    """Extracts a nested value from JSON dict/list via dot notation (e.g. 'choices.0.message.content')."""
    if not path_str or data is None:
        return data
    current = data
    for part in path_str.split('.'):
        if isinstance(current, dict):
            current = current.get(part)
        elif isinstance(current, list) and part.isdigit():
            idx = int(part)
            current = current[idx] if 0 <= idx < len(current) else None
        else:
            return None
        if current is None:
            break
    return current


class HarnessAdapter:
    """
    Adapter Pattern for AI Harnesses and CLI Backends.
    Normalizes divergent I/O protocols:
      - Input Strategy: 'arg' | 'stdin' | 'temp_file'
      - Output Strategy: 'stdout' | 'temp_file' | 'json'
      - Sanitization Pipeline: ANSI escape removal, markdown code fence stripping, JSON key extraction
    """
    def __init__(self, name: str, spec: dict):
        self.name = name
        self.description = spec.get("description", f"AI Harness {name}")
        cmd = spec.get("command", [name])
        if isinstance(cmd, str):
            self.command = shlex.split(cmd)
        else:
            self.command = list(cmd)
        self.input_mode = spec.get("input_mode", "arg")        # "arg" | "stdin" | "temp_file"
        self.output_mode = spec.get("output_mode", "stdout")   # "stdout" | "temp_file" | "json"
        self.json_key = spec.get("json_key", "response")
        self.model_flag = spec.get("model_flag")
        self.effort_flag = spec.get("effort_flag")
        self.default_model = spec.get("default_model")
        self.default_effort = spec.get("default_effort")
        self.clean_ansi = spec.get("clean_ansi", True)
        self.clean_markdown = spec.get("clean_markdown", True)
        self.timeout_sec = spec.get("timeout_sec", 60)
        self.mode_flags = spec.get("mode_flags", {})
        self.format_flags = spec.get("format_flags", {})

    def is_available(self) -> bool:
        if not self.command:
            return False
        bin_name = self.command[0]
        return bool(shutil.which(bin_name) or os.path.exists(bin_name))

    def execute(
        self,
        prompt: str,
        model: str = None,
        effort: str = None,
        timeout_sec: int = None,
        clean_markdown_fence: bool = True,
        mode: str = "agent",
        output_format: str = "text",
        system_prompt: str = None
    ) -> str:
        effective_timeout = timeout_sec or self.timeout_sec
        prompt_file = None
        output_file = None

        norm_mode = (mode or "agent").lower().strip()
        norm_format = (output_format or "text").lower().strip()

        # Prepend system prompt or add conversational prompt framing when needed
        active_prompt = prompt
        if system_prompt:
            active_prompt = f"{system_prompt.strip()}\n\n{active_prompt}"
        elif norm_mode in ("chat", "ask") and not self.mode_flags.get(norm_mode):
            active_prompt = f"[Direct Single-Turn Chat Mode: Answer directly and concisely in a single turn without running multi-step agent actions or modifying files]\n\n{active_prompt}"
        elif norm_mode in ("action", "simple-agent") and not self.mode_flags.get(norm_mode):
            active_prompt = f"[Single Action Mode: Execute the requested order directly in a single step without conversational preambles]\n\n{active_prompt}"

        try:
            cmd_args = list(self.command)
            input_data = None

            # 1. Mode flags injection
            if norm_mode in self.mode_flags:
                extra_mode_args = self.mode_flags[norm_mode]
                if isinstance(extra_mode_args, str):
                    extra_mode_args = shlex.split(extra_mode_args)
                cmd_args.extend(extra_mode_args)

            # 2. Format flags injection (if backend supports native format flag)
            if norm_format in self.format_flags:
                extra_fmt_args = self.format_flags[norm_format]
                if isinstance(extra_fmt_args, str):
                    extra_fmt_args = shlex.split(extra_fmt_args)
                cmd_args.extend(extra_fmt_args)

            # 3. Input strategy
            if self.input_mode == "temp_file":
                with tempfile.NamedTemporaryFile("w+", suffix=".prompt.txt", delete=False, encoding="utf-8") as tf:
                    tf.write(active_prompt)
                    prompt_file = tf.name
                has_pf = any("{prompt_file}" in a or "{input_file}" in a for a in cmd_args)
                if has_pf:
                    cmd_args = [a.replace("{prompt_file}", prompt_file).replace("{input_file}", prompt_file) for a in cmd_args]
                else:
                    cmd_args.append(prompt_file)

            elif self.input_mode == "stdin":
                input_data = active_prompt
                cmd_args = [a for a in cmd_args if a != "{prompt}"]

            else:  # "arg"
                has_prompt = any("{prompt}" in a for a in cmd_args)
                if has_prompt:
                    cmd_args = [a.replace("{prompt}", active_prompt) for a in cmd_args]
                else:
                    cmd_args.append(active_prompt)

            # 4. Output strategy
            if self.output_mode == "temp_file":
                with tempfile.NamedTemporaryFile("w+", suffix=".out.txt", delete=False, encoding="utf-8") as tf:
                    output_file = tf.name
                has_of = any("{output_file}" in a for a in cmd_args)
                if has_of:
                    cmd_args = [a.replace("{output_file}", output_file) for a in cmd_args]
                else:
                    cmd_args.extend(["--output", output_file])

            # 5. Model flag injection
            eff_model = model or self.default_model
            if eff_model:
                has_model = any("{model}" in a for a in cmd_args)
                if has_model:
                    cmd_args = [a.replace("{model}", eff_model) for a in cmd_args]
                elif self.model_flag:
                    cmd_args.extend([self.model_flag, eff_model])

            # 6. Effort flag injection
            eff_effort = effort or self.default_effort
            if eff_effort:
                has_effort = any("{effort}" in a for a in cmd_args)
                if has_effort:
                    cmd_args = [a.replace("{effort}", eff_effort) for a in cmd_args]
                elif self.effort_flag:
                    cmd_args.extend([self.effort_flag, eff_effort])

            # 7. Check executable existence
            bin_name = cmd_args[0]
            if not shutil.which(bin_name) and not os.path.exists(bin_name):
                raise FileNotFoundError(f"AI CLI binary '{bin_name}' not found in PATH for backend '{self.name}'.")

            # 8. Execute subprocess with isolated pipes
            res = subprocess.run(
                cmd_args,
                input=input_data,
                capture_output=True,
                text=True,
                timeout=effective_timeout
            )

            if res.returncode != 0:
                err = res.stderr.strip() or res.stdout.strip()
                raise RuntimeError(f"Harness '{self.name}' exited with code {res.returncode}: {err}")

            # 9. Output extraction
            if norm_format == "raw":
                return res.stdout

            if self.output_mode == "temp_file" and output_file and os.path.exists(output_file):
                with open(output_file, "r", encoding="utf-8", errors="replace") as f:
                    raw_output = f.read()
            elif self.output_mode == "json":
                raw_stdout = res.stdout.strip()
                try:
                    parsed = json.loads(raw_stdout)
                    extracted = extract_json_path(parsed, self.json_key)
                    raw_output = str(extracted) if extracted is not None else raw_stdout
                except Exception:
                    raw_output = raw_stdout
            else:
                raw_output = res.stdout

            # 10. Post-processing & Sanitization Pipeline
            output = raw_output
            if self.clean_ansi:
                output = strip_ansi_codes(output)

            output = output.strip()

            if clean_markdown_fence and self.clean_markdown:
                output = re.sub(r'^```[a-zA-Z]*\n', '', output)
                output = re.sub(r'\n```$', '', output).strip()
                if output.startswith('"') and output.endswith('"'):
                    output = output[1:-1].strip()

            # 11. Format final output
            if norm_format == "json":
                try:
                    parsed_json = json.loads(output)
                    return json.dumps(parsed_json, indent=2)
                except Exception:
                    envelope = {
                        "backend": self.name,
                        "model": eff_model or "default",
                        "mode": norm_mode,
                        "status": "success",
                        "response": output
                    }
                    return json.dumps(envelope, indent=2)

            return output

        finally:
            if prompt_file and os.path.exists(prompt_file):
                try:
                    os.remove(prompt_file)
                except OSError:
                    pass
            if output_file and os.path.exists(output_file):
                try:
                    os.remove(output_file)
                except OSError:
                    pass


def resolve_backend_adapter(backend_name: str, config: dict = None) -> HarnessAdapter:
    """Resolves a backend name to its corresponding HarnessAdapter."""
    cfg = config or load_config()
    custom_backends = cfg.get("backends", {})

    target_name = (backend_name or "").strip()
    if not target_name:
        target_name = cfg.get("commit", {}).get("default_backend") or cfg.get("default_commit_backend", "agy")

    # 1. Custom backend from configuration
    if target_name in custom_backends:
        return HarnessAdapter(target_name, custom_backends[target_name])

    # 2. Built-in backend
    if target_name in DEFAULT_BACKENDS:
        return HarnessAdapter(target_name, DEFAULT_BACKENDS[target_name])

    # 3. Ad-hoc command string or binary found in PATH
    if " " in target_name or "/" in target_name or shutil.which(target_name):
        ad_hoc_spec = {
            "command": shlex.split(target_name),
            "input_mode": "stdin",
            "output_mode": "stdout",
            "clean_ansi": True,
            "clean_markdown": True
        }
        return HarnessAdapter(target_name, ad_hoc_spec)

    # 4. Unknown backend: raise informative error
    available = sorted(set(list(DEFAULT_BACKENDS.keys()) + list(custom_backends.keys())))
    raise ValueError(f"Unknown AI backend '{backend_name}'. Available backends: {', '.join(available)}")


