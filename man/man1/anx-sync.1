.TH "ANX" "1" "Oct 2026" "anx 1.0.0" "Anx User Manual"

.SH NAME
anx-sync - Deploy dotfiles with true 3-way merge (or --push to capture them back into the repo)


.SH SYNOPSIS
\fBanx sync [group|config-id] [flags]\fP


.SH DESCRIPTION
Groups: terminal, editor, devtools, ai, osconfig, vscode, cursor, all.
vscode and cursor are only synced when named explicitly.


.SH OPTIONS
\fB--force\fP[=false]
	Repository version wins on conflicts

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for sync

.PP
\fB--push\fP[=false]
	Capture live dotfiles back into the repository


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--dry-run\fP[=false]
	Preview actions without mutating the system

.PP
\fB--format\fP="text"
	Output format (text|json|yaml)

.PP
\fB--include-hacks\fP[=false]
	Include matched hardware workstation hacks during apply

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	Force interactive prompts

.PP
\fB--no-color\fP[=false]
	Disable ANSI color rendering

.PP
\fB--offline\fP[=false]
	Disable network queries

.PP
\fB--profile\fP="developer"
	Target profile name

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--theme\fP="tokyo-night"
	UI theme (see 'anx theme list')

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose execution logging

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Automatically answer yes to confirmations


