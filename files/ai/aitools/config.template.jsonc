{
  "version": "1.0.0",
  "default_commit_backend": "agy",
  "commit": {
    "default_backend": "agy",
    "model": null,
    "effort": "low",
    "default_stage_all": false,
    "max_diff_length": 15000,
    "default_template": "conventional",
    "auto_detect_repo_template": true,
    "task_id": null
  },
  "daemon": {
    "auto_wake": {
      "enabled": true,
      "time": "04:00",
      "auto_resuspend": true,
      "resuspend_delay_seconds": 12,
      "max_wake_window_minutes": 15
    },
    "active_hours": {
      "start": "03:55",
      "end": "22:00"
    },
    "reset_alert_lead_minutes": 5,
    "desktop_notifications": true,
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "chat_id": ""
    }
  },
  "targets": [
    {
      "id": "gemini",
      "name": "Google Gemini (Antigravity)",
      "tool": "agy",
      "account": "default",
      "enabled": true,
      "telemetry_type": "agy_usage",
      "bucket_id": "gemini-5h",
      "wake_command": [
        "agy",
        "-p",
        "Reply with: 1",
        "--model",
        "gemini-3.8-flash-low",
        "--effort",
        "low"
      ],
      "status_command": [
        "agy",
        "-p",
        "/usage",
        "--output-format",
        "json"
      ],
      "fallback_interval_hours": 5,
      "timeout_sec": 20
    }
  ],
  "commands": {
    "review": {
      "description": "Perform an AI code review on current staged git diff",
      "backend": "agy",
      "model": null,
      "effort": "low",
      "input_type": "git_staged_diff",
      "prompt_template": "You are a Principal Software Architect. Review the following git diff for logical bugs, security vulnerabilities, edge cases, and performance regressions. Be concise, actionable, and prioritize findings by severity:\n\n{input}"
    }
  }
}