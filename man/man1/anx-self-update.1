.TH "ANX" "1" "Oct 2026" "anx 1.0.0" "Anx User Manual"

.SH NAME
anx-self-update - Check for and securely update the ANX binary to the latest verified release


.SH SYNOPSIS
\fBanx self update [flags]\fP


.SH DESCRIPTION
Check for and securely update the ANX binary to the latest verified release


.SH OPTIONS
\fB--check\fP[=false]
	Check for available updates without applying

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--include-prerelease\fP[=false]
	Include pre-releases when checking latest release

.PP
\fB--method\fP="auto"
	Update method (auto|release|go-install)

.PP
\fB--tag\fP=""
	Explicit release tag to update or downgrade to (e.g. v1.2.0)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--destroyer\fP[=false]
	Destroyer mode: aggressively purge packages, tools, configurations, and state

.PP
\fB--destroyer-reinstall\fP[=false]
	Alias for --destroyer

.PP
\fB--dry-run\fP[=false]
	Preview actions without mutating the system

.PP
\fB--force\fP[=false]
	Force operation and bypass confirmation prompts

.PP
\fB--format\fP="text"
	Output format (text|json|yaml)

.PP
\fB--include-hacks\fP[=false]
	Include matched hardware workstation hacks during apply

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	Force interactive prompts

.PP
\fB--no-color\fP[=false]
	Disable ANSI color rendering

.PP
\fB--offline\fP[=false]
	Disable network queries

.PP
\fB--profile\fP="developer"
	Target profile name

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--script\fP[=false]
	Output shell script preview of planned actions

.PP
\fB--theme\fP="tokyo-night"
	UI theme (see 'anx theme list')

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose execution logging

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Automatically answer yes to confirmations


.SH EXAMPLE
.EX
  # Check if updates to anx are available without applying
  anx self update --check

  # Preview update in dry-run mode
  anx self update --dry-run

  # Apply verified update to latest stable release
  anx self update

  # Update to a specific release tag (can upgrade or downgrade)
  anx self update --tag v1.2.0

  # Update via go install (using the Go toolchain)
  anx self update --method go-install
.EE


