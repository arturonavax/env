def fire_wake_command(target: dict) -> tuple[bool, str]:
    cmd = target.get("wake_command", [])
    if not cmd:
        return False, "No wake_command configured"

    timeout = target.get("timeout_sec", 25)
    t0 = time.time()
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        elapsed = round(time.time() - t0, 2)
        if proc.returncode == 0:
            sample = proc.stdout.strip().replace("\n", " ")[:60] or "ok"
            return True, f"Success in {elapsed}s (Response: '{sample}')"
        else:
            err = proc.stderr.strip()[:80] or proc.stdout.strip()[:80] or f"Exit {proc.returncode}"
            return False, f"Failed ({elapsed}s): {err}"
    except subprocess.TimeoutExpired:
        return False, f"Timed out after {timeout}s"
    except Exception as e:
        return False, f"Error: {e}"


def run_wake(force: bool = False, target_filter: str = None, reason: str = "manual") -> bool:
    config = load_config()
    state = load_state()

    print(f"\n{C_BOLD}{C_CYAN}==> aitools · Model Wakeup & Rolling Quota Priming{C_RESET}")
    print(f"  {C_DIM}Verifying internet connection...{C_RESET}")
    if not wait_for_internet(timeout_sec=20):
        print(f"  {C_RED}✗ No internet connection. Wakeup cycle aborted.{C_RESET}", file=sys.stderr)
        send_notification("aitools: No Network", "Internet offline. Model wakeup skipped.", urgency="critical")
        return False

    targets = evaluate_all_targets(config, state)
    target_dict = {t["id"]: t for t in config.get("targets", [])}

    any_woken = False
    now_epoch = time.time()

    for item in targets:
        t_id = item["id"]
        if target_filter and t_id != target_filter:
            continue
        if not item["enabled"]:
            continue

        raw_target = target_dict.get(t_id, {})
        print(f"  • {C_BOLD}{item['name']}{C_RESET} [{item['tool']} / {item['account']}]:")
        print(f"    Status:    {item['status_label']}")
        print(f"    Remaining: {item['remaining_percent']}%")

        if force or item["needs_wake"]:
            print(f"    {C_YELLOW}⚡ Sending minimal wakeup probe...{C_RESET}")
            ok, msg = fire_wake_command(raw_target)
            if ok:
                print(f"    {C_GREEN}✓ {msg}{C_RESET}")
                state.setdefault("targets_last_wake", {})[t_id] = now_epoch
                any_woken = True
            else:
                print(f"    {C_RED}✗ {msg}{C_RESET}")
        else:
            print(f"    {C_GREEN}✓ Quota window already active. Skipping probe.{C_RESET}")

    state["last_wake_epoch"] = now_epoch
    save_state(state)
    return True


