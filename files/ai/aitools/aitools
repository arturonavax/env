# ------------------------------------------------------------------------------
# UIBox: Dynamic Terminal-Aware Box Drawing & Normalization Engine
# ------------------------------------------------------------------------------
class UIBox:
    """Dynamic, ANSI-aware box drawing, table separator, and banner renderer."""

    STYLES = {
        "rounded": {"tl": "╭", "tr": "╮", "bl": "╰", "br": "╯", "h": "─", "v": "│", "ml": "├", "mr": "┤"},
        "single":  {"tl": "┌", "tr": "┐", "bl": "└", "br": "┘", "h": "─", "v": "│", "ml": "├", "mr": "┤"},
        "double":  {"tl": "╔", "tr": "╗", "bl": "╚", "br": "╝", "h": "═", "v": "║", "ml": "╠", "mr": "╣"},
        "ascii":   {"tl": "+", "tr": "+", "bl": "+", "br": "+", "h": "-", "v": "|", "ml": "+", "mr": "+"},
    }

    _ANSI_RE = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')

    @classmethod
    def strip_ansi(cls, text: str) -> str:
        """Removes ANSI escape codes and carriage returns to compute visible string width."""
        if not text:
            return ""
        clean = cls._ANSI_RE.sub('', str(text))
        return clean.replace('\r', '')

    @classmethod
    def visible_len(cls, text: str) -> int:
        """Calculates visual terminal length ignoring ANSI codes."""
        return len(cls.strip_ansi(text))

    @classmethod
    def get_width(cls, default: int = 84, min_w: int = 40, max_w: int = 100) -> int:
        """Dynamically detects terminal columns and clamps between min_w and max_w."""
        try:
            cols = shutil.get_terminal_size(fallback=(default, 24)).columns
            if cols > 2:
                cols -= 2
        except Exception:
            cols = default

        return max(min_w, min(max_w, cols))

    @classmethod
    def top(cls, width: Optional[int] = None, style: str = "rounded", color: str = C_BOLD_BLUE) -> str:
        w = width if width is not None else cls.get_width()
        s = cls.STYLES.get(style, cls.STYLES["rounded"])
        inner = s["h"] * max(0, w - 2)
        return f"{color}{s['tl']}{inner}{s['tr']}{C_RESET}"

    @classmethod
    def mid(cls, width: Optional[int] = None, style: str = "rounded", color: str = C_BOLD_BLUE) -> str:
        w = width if width is not None else cls.get_width()
        s = cls.STYLES.get(style, cls.STYLES["rounded"])
        inner = s["h"] * max(0, w - 2)
        return f"{color}{s['ml']}{inner}{s['mr']}{C_RESET}"

    @classmethod
    def bottom(cls, width: Optional[int] = None, style: str = "rounded", color: str = C_BOLD_BLUE) -> str:
        w = width if width is not None else cls.get_width()
        s = cls.STYLES.get(style, cls.STYLES["rounded"])
        inner = s["h"] * max(0, w - 2)
        return f"{color}{s['bl']}{inner}{s['br']}{C_RESET}"

    @classmethod
    def line(
        cls,
        text: str,
        width: Optional[int] = None,
        style: str = "rounded",
        border_color: str = C_BOLD_BLUE,
        text_color: str = "",
        align: str = "left"
    ) -> str:
        w = width if width is not None else cls.get_width()
        s = cls.STYLES.get(style, cls.STYLES["rounded"])
        inner_width = max(0, w - 4)
        vlen = cls.visible_len(text)

        if vlen >= inner_width:
            pad_l, pad_r = 0, 0
        elif align == "center":
            total_pad = inner_width - vlen
            pad_l = total_pad // 2
            pad_r = total_pad - pad_l
        elif align == "right":
            pad_l = inner_width - vlen
            pad_r = 0
        else:  # left
            pad_l = 0
            pad_r = inner_width - vlen

        spaces_l = " " * pad_l
        spaces_r = " " * pad_r

        return f"{border_color}{s['v']}{C_RESET}  {spaces_l}{text_color}{text}{spaces_r}  {border_color}{s['v']}{C_RESET}"

    @classmethod
    def rule(cls, width: Optional[int] = None, char: str = "─", color: str = C_DIM) -> str:
        w = width if width is not None else cls.get_width()
        return f"{color}{char * w}{C_RESET}"

    @classmethod
    def banner(
        cls,
        title: str,
        subtitle: str = "",
        width: Optional[int] = None,
        color: str = C_BOLD_BLUE,
        style: str = "rounded"
    ) -> None:
        w = width if width is not None else cls.get_width()
        print()
        print(cls.top(w, style=style, color=color))
        print(cls.line(title, w, style=style, border_color=color, text_color=C_BOLD_WHITE, align="left"))
        if subtitle:
            print(cls.mid(w, style=style, color=color))
            print(cls.line(subtitle, w, style=style, border_color=color, text_color=C_RESET, align="left"))
        print(cls.bottom(w, style=style, color=color))
        print()

