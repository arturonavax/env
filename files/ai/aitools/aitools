    p_daemon.add_argument("extra_arg", nargs="?", default="", help="Optional parameter for daemon action (e.g. on/off)")

    # 7. Status
    subparsers.add_parser("status", help="Check availability and paths of AI tools and runtimes")

    # 8. Config
    p_config = subparsers.add_parser("config", help="Show, edit, or locate configuration file")
    p_config.add_argument("config_action", choices=["show", "path", "init", "wizard", "interactive"], default="show", nargs="?")
    p_config.add_argument("-i", "--interactive", action="store_true", help="Launch interactive configuration wizard")

    # 9. Setup (Interactive Configuration Wizard)
    subparsers.add_parser("setup", help="Launch interactive setup & configuration wizard")

    # 10. Run (Declarative Custom Command)
    p_run = subparsers.add_parser("run", help="Execute a custom declarative AI command/pipeline")
    p_run.add_argument("command_name", help="Name of custom command defined in ~/.config/aitools/config.json")
    p_run.add_argument("args", nargs=argparse.REMAINDER, help="Arguments passed to custom command")

    # 11. Commands (List all built-in and declarative custom commands)
    subparsers.add_parser("commands", help="List all built-in and declarative custom AI commands")

    # 12. LLM (Unified Non-Interactive Harness Wrapper)
    p_llm = subparsers.add_parser(
        "llm",
        help="Execute non-interactive prompt queries through any AI CLI harness (supports stdin streaming, files, and modes)"
    )
    p_llm.add_argument("prompt", nargs="*", help="Prompt or instruction for the AI harness")
    p_llm.add_argument("-b", "--backend", help="AI CLI backend (agy, claude, codex, llm, opencode, pi, ollama, or custom harness/binary)")
    p_llm.add_argument("-m", "--model", help="Model identifier override (e.g. gemini-2.5-flash, claude-3-7-sonnet)")
    p_llm.add_argument("-e", "--effort", choices=["low", "medium", "high", "xhigh", "max"], help="Reasoning effort level")
    p_llm.add_argument("-f", "--file", action="append", help="Attach file content to context (repeatable)")
    p_llm.add_argument("-d", "--dir", action="append", help="Attach directory tree and contents to context (repeatable)")
    p_llm.add_argument(
        "--mode",
        choices=["chat", "ask", "action", "simple-agent", "agent"],
        help="Execution mode: 'chat'/'ask' (single ask->response), 'action'/'simple-agent' (single action), 'agent' (normal agentic execution)"
    )
    p_llm.add_argument(
        "-o", "--output-format",
        choices=["text", "json", "raw"],
        help="Output format: 'text' (cleaned text), 'json' (structured JSON), 'raw' (unmodified stdout)"
    )
    p_llm.add_argument("-O", "--output-file", help="Path to write LLM response output to")
    p_llm.add_argument("-s", "--system", help="System prompt or context preamble")
    p_llm.add_argument("-t", "--timeout", type=int, help="Command timeout in seconds")
    p_llm.add_argument("--no-clean-markdown", action="store_true", help="Do not strip markdown code fences from response")
    p_llm.add_argument("--list-backends", action="store_true", help="List all available AI CLI harnesses and execution strategies")

    # 7. System Hardware & Performance Optimizer
    p_opt = subparsers.add_parser(
        "optimize",
        aliases=["sysopt"],
        help="Audit hardware, kernel & Lynis security and generate AI optimization script (ai-opt)"
    )
    p_opt.add_argument("-d", "--dry-run", action="store_true", help="Audit, generate script & validate guardrails without applying (default)")
    p_opt.add_argument("-y", "--apply", action="store_true", help="Generate, validate guardrails, and execute optimizations")
    p_opt.add_argument("-a", "--audit-only", action="store_true", help="Print distilled hardware & security actionable report and exit")
    p_opt.add_argument("--skip-lynis", action="store_true", help="Bypass Lynis audit scan (rely on native security audit)")
    p_opt.add_argument("-w", "--wizard", action="store_true", help="Launch interactive step-by-step TUI wizard")
    p_opt.add_argument("-o", "--output", help="Save generated optimization script directly to file")
    p_opt.add_argument("-b", "--backend", help="AI CLI backend override")
    p_opt.add_argument("-m", "--model", help="AI model identifier override")
    p_opt.add_argument("--validate", help="Validate an existing script against the security guardrail engine")

    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    if args.subcommand == "quota":
        show_quota(as_json=args.json, target_filter=args.target)
    elif args.subcommand == "watch":
        run_watch(interval_sec=args.interval, target_filter=args.target)
    elif args.subcommand == "wake":
        run_wake(force=args.force, target_filter=args.target)
    elif args.subcommand == "commit":
        run_commit(
            stage_all=args.all,
            backend=args.backend,
            model=args.model,
            template=args.template,
            task_id=getattr(args, "task_id", None) or getattr(args, "jira_id", None),
            scope=args.scope,
            dry_run=args.dry_run,
            list_templates=args.list_templates,
            list_backends=args.list_backends
        )
    elif args.subcommand == "pr":
        run_pr(
            base=args.base,
            head=args.head,
            backend=args.backend,
            model=args.model,
            template=args.template,
            task_id=getattr(args, "task_id", None),
            output_file=args.output,
            copy_clipboard=args.copy,
            print_raw=args.print,
            dry_run=args.dry_run,
            list_templates=args.list_templates,
            list_backends=args.list_backends
        )
    elif args.subcommand == "llm":
        run_llm_cli(args)
    elif args.subcommand in ("optimize", "sysopt"):
        run_system_optimize(args)
    elif args.subcommand == "backends":
        show_backends()
    elif args.subcommand == "setup":
        run_config_wizard()
    elif args.subcommand == "daemon":
        handle_daemon_cli(args)
    elif args.subcommand == "status":
        show_status()
    elif args.subcommand == "run":
        cfg = load_config()
        custom_cmds = cfg.get("commands", {})
        cmd_name = args.command_name
        if cmd_name not in custom_cmds:
            print(f"{C_RED}[ERROR] Unknown custom command '{cmd_name}'. Available commands:{C_RESET}", file=sys.stderr)
            for c in custom_cmds:
                print(f"  - {c}", file=sys.stderr)
            sys.exit(1)
        execute_custom_command(cmd_name, custom_cmds[cmd_name], args.args)
    elif args.subcommand == "commands":
        show_commands()
    elif args.subcommand == "config":
        if getattr(args, "interactive", False) or args.config_action in ("wizard", "interactive"):
            run_config_wizard()
        elif args.config_action == "path":
            print(CONFIG_FILE)
        elif args.config_action == "init":
            repo_template = os.path.join(os.path.dirname(__file__), "config.template.jsonc")
            repo_default = os.path.join(os.path.dirname(__file__), "config.default.json")
            if os.path.exists(repo_template):
                with open(repo_template, "r", encoding="utf-8") as f:
                    content = f.read()
                with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                    f.write(content)
            elif os.path.exists(repo_default):
                with open(repo_default, "r", encoding="utf-8") as f:
                    content = f.read()
                with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                    f.write(content)
            else:
                save_config(DEFAULT_CONFIG)
            print(f"{C_GREEN}✓ Configuration initialized at {CONFIG_FILE}{C_RESET}")
        else:
            if os.path.exists(CONFIG_FILE):
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    print(f.read().strip())
            else:
                cfg = load_config()
                print(json.dumps(cfg, indent=2))


if __name__ == "__main__":
    main()
