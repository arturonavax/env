def execute_custom_command(cmd_name: str, cmd_def: dict, extra_args: list[str]) -> None:
    config = load_config()
    backend = cmd_def.get("backend") or config.get("default_commit_backend", "agy")
    model = cmd_def.get("model")
    effort = cmd_def.get("effort", "low")
    input_type = cmd_def.get("input_type", "args")
    prompt_template = cmd_def.get("prompt_template", "{input}")
    max_len = cmd_def.get("max_input_length", 25000)
    timeout_sec = cmd_def.get("timeout_sec", 60)

    # 1. Gather input according to input_type
    input_text = ""
    if input_type == "git_staged_diff":
        diff, ok = get_git_diff(stage_all=False)
        if not ok or not diff.strip():
            print(f"{C_RED}[ERROR] No git diff found. Stage files with 'git add' or modify tracked files.{C_RESET}", file=sys.stderr)
            sys.exit(1)
        input_text = diff

    elif input_type == "git_diff":
        res = subprocess.run(["git", "diff", "HEAD"], capture_output=True, text=True)
        if res.returncode != 0 or not res.stdout.strip():
            res = subprocess.run(["git", "diff"], capture_output=True, text=True)
        if not res.stdout.strip():
            print(f"{C_RED}[ERROR] No git diff found in current repository.{C_RESET}", file=sys.stderr)
            sys.exit(1)
        input_text = res.stdout

    elif input_type == "stdin":
        if sys.stdin.isatty():
            print(f"{C_YELLOW}Reading input from stdin (Press Ctrl+D when finished):{C_RESET}", file=sys.stderr)
        input_text = sys.stdin.read()

    elif input_type == "args":
        if not extra_args:
            print(f"{C_RED}[ERROR] Command '{cmd_name}' requires arguments. Example: aitools {cmd_name} <arguments>{C_RESET}", file=sys.stderr)
            sys.exit(1)
        input_text = " ".join(extra_args)

    elif input_type == "stdin_or_args":
        if not sys.stdin.isatty():
            input_text = sys.stdin.read()
        elif extra_args:
            input_text = " ".join(extra_args)
        else:
            print(f"{C_YELLOW}Reading input from stdin (Press Ctrl+D when finished):{C_RESET}", file=sys.stderr)
            input_text = sys.stdin.read()

    elif input_type == "file":
        if not extra_args:
            print(f"{C_RED}[ERROR] Command '{cmd_name}' requires a file path argument.{C_RESET}", file=sys.stderr)
            sys.exit(1)
        file_path = extra_args[0]
        if not os.path.exists(file_path):
            print(f"{C_RED}[ERROR] File not found: {file_path}{C_RESET}", file=sys.stderr)
            sys.exit(1)
        with open(file_path, "r", encoding="utf-8", errors="replace") as f:
            input_text = f.read()

    elif input_type == "none":
        input_text = ""

    else:
        if extra_args:
            input_text = " ".join(extra_args)
        elif not sys.stdin.isatty():
            input_text = sys.stdin.read()

    if max_len and len(input_text) > max_len:
        input_text = input_text[:max_len] + "\n... [input truncated for length]"

    # 2. Render prompt
    if "{input}" in prompt_template:
        prompt = prompt_template.format(input=input_text)
    else:
        prompt = f"{prompt_template}\n\n{input_text}" if input_text else prompt_template

    # 3. Inform user (sent to stderr so pipeable stdout remains clean)
    desc = cmd_def.get("description", cmd_name)
    print(f"{C_BOLD}{C_CYAN}==> aitools [{cmd_name}]: {C_WHITE}{desc}{C_RESET} {C_DIM}(Backend: {backend}){C_RESET}", file=sys.stderr)

    # 4. Query LLM and print to stdout
    try:
        response = query_llm(
            prompt,
            backend=backend,
            model=model,
            effort=effort,
            timeout_sec=timeout_sec,
            clean_markdown_fence=False
        )
        print(response)
    except Exception as e:
        print(f"{C_RED}[ERROR] {e}{C_RESET}", file=sys.stderr)
        sys.exit(1)


