.TH "ANX" "1" "Oct 2026" "anx 1.0.0" "Anx User Manual"

.SH NAME
anx-audit - Multi-level system security audit with profile hardening and remediation scripts


.SH SYNOPSIS
\fBanx audit [flags]\fP


.SH DESCRIPTION
Run comprehensive, profile-aware system security audits across network/firewall,
authentication, permissions, kernel sysctl parameters, and package vulnerabilities.

.PP
Profiles:
  workstation : Developer workstation/laptop (balanced security and usability)
  server      : Hardened production server (strict firewall, no root SSH, strict sysctl)
  minimal     : Essential baseline checks

.PP
Supports generating reproducible, idempotent Bash remediation scripts with static
security guardrails, and optional AI synthesis via the configured aitools harness.


.SH OPTIONS
\fB--ai\fP[=false]
	Synthesize remediation script using configured AI harness

.PP
\fB--apply\fP[=false]
	Execute the guardrail-validated remediation script

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for audit

.PP
\fB-p\fP, \fB--packages\fP[=false]
	Scan managed package tools for known OSV vulnerabilities

.PP
\fB-P\fP, \fB--profile\fP="workstation"
	Audit profile (workstation|server|minimal)

.PP
\fB-r\fP, \fB--report\fP[=false]
	Print detailed markdown audit report

.PP
\fB-s\fP, \fB--script\fP[=false]
	Print generated shell remediation script


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--dry-run\fP[=false]
	Preview actions without mutating the system

.PP
\fB--format\fP="text"
	Output format (text|json|yaml)

.PP
\fB--include-hacks\fP[=false]
	Include matched hardware workstation hacks during apply

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	Force interactive prompts

.PP
\fB--no-color\fP[=false]
	Disable ANSI color rendering

.PP
\fB--offline\fP[=false]
	Disable network queries

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--theme\fP="tokyo-night"
	UI theme (see 'anx theme list')

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose execution logging

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Automatically answer yes to confirmations


.SH EXAMPLE
.EX
  # Run default workstation security audit
  anx audit

  # Run strict server security audit
  anx audit --profile server

  # Output inspectable shell remediation script
  anx audit --script

  # Synthesize remediation script using configured AI harness and review
  anx audit --ai --script

  # Apply verified remediations
  anx audit --apply

  # Scan installed package binaries against OSV.dev vulnerabilities
  anx audit --packages
.EE


