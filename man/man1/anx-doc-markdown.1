.nh
.TH "ANX" "1" "Oct 2026" "anx 1.0.0" "Anx User Manual"

.SH NAME
anx-doc-markdown - Generate complete Markdown reference documentation for all commands


.SH SYNOPSIS
\fBanx doc markdown [flags]\fP


.SH DESCRIPTION
Generate structured GitHub-flavored Markdown files for the entire anx CLI command hierarchy.


.SH OPTIONS
\fB--dir\fP=""
	Target directory for markdown docs (defaults to docs/cli/)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for markdown


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--destroyer\fP[=false]
	Destroyer mode: aggressively purge packages, tools, configurations, and state

.PP
\fB--destroyer-reinstall\fP[=false]
	Alias for --destroyer

.PP
\fB--dry-run\fP[=false]
	Preview actions without mutating the system

.PP
\fB--force\fP[=false]
	Force operation and bypass confirmation prompts

.PP
\fB--format\fP="text"
	Output format (text|json|yaml)

.PP
\fB--include-hacks\fP[=false]
	Include matched hardware workstation hacks during apply

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	Force interactive prompts

.PP
\fB--no-color\fP[=false]
	Disable ANSI color rendering

.PP
\fB--offline\fP[=false]
	Disable network queries

.PP
\fB--profile\fP="developer"
	Target profile name

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--script\fP[=false]
	Output shell script preview of planned actions

.PP
\fB--theme\fP="tokyo-night"
	UI theme (see 'anx theme list')

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose execution logging

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Automatically answer yes to confirmations


.SH EXAMPLE
.EX
  # Generate markdown docs into docs/cli/
  anx doc markdown --dir docs/cli/
.EE


.SH SEE ALSO
\fBanx-doc(1)\fP


