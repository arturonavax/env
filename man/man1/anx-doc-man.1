.TH "ANX" "1" "Oct 2026" "anx 1.0.0" "Anx User Manual"

.SH NAME
anx-doc-man - Generate standard Unix troff man pages (section 1)


.SH SYNOPSIS
\fBanx doc man [flags]\fP


.SH DESCRIPTION
Generate section 1 man pages for anx and all subcommands using cobra/doc.

.PP
Pass --install to automatically install generated man pages into ~/.local/share/man/man1
so they are immediately accessible via 'man anx'.


.SH OPTIONS
\fB--dir\fP=""
	Target directory for man pages (defaults to ./man or ~/.local/share/man/man1 with --install)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for man

.PP
\fB--install\fP[=false]
	Install man pages to user's ~/.local/share/man/man1 directory


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--dry-run\fP[=false]
	Preview actions without mutating the system

.PP
\fB--format\fP="text"
	Output format (text|json|yaml)

.PP
\fB--include-hacks\fP[=false]
	Include matched hardware workstation hacks during apply

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	Force interactive prompts

.PP
\fB--no-color\fP[=false]
	Disable ANSI color rendering

.PP
\fB--offline\fP[=false]
	Disable network queries

.PP
\fB--profile\fP="developer"
	Target profile name

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--script\fP[=false]
	Output shell script preview of planned actions

.PP
\fB--theme\fP="tokyo-night"
	UI theme (see 'anx theme list')

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose execution logging

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Automatically answer yes to confirmations


.SH EXAMPLE
.EX
  # Generate man pages in ./man/man1
  anx doc man --dir ./man/man1

  # Automatically install man pages for the current user
  anx doc man --install
.EE


.SH SEE ALSO
\fBanx-doc(1)\fP


