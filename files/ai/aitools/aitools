def wrap_repo_template_as_prompt(raw_template: str, source_desc: str) -> str:
    """Wraps a repository-level commit template into an instruction prompt if it lacks instructions."""
    if "{diff}" in raw_template:
        return raw_template
    return f"""You are an expert developer creating a git commit message for this repository.
Analyze the following git diff and output a single, high-quality commit message that strictly adheres to this repository's commit template ({source_desc}).

Repository Commit Template & Guidelines:
---
{raw_template.strip()}
---

Context:
- Current Branch: {{branch}}
- Task / Issue ID: {{task_id}}
- Modified Files: {{files}}

Requirements:
1. Follow the exact structure, casing, and guidelines shown in the repository template above.
2. Replace any task or issue placeholders with the actual Task ID ({{task_id}}).
3. If comment lines starting with '#' are present in the template, omit them from the final commit message.
4. Keep the summary line concise (< 72 characters).
5. Output in English.
6. Do NOT include markdown code blocks (no ``` backticks), quotes, or explanation.
7. Do NOT add "Co-Authored-By", AI attribution, or metadata.
8. Output ONLY the raw commit message.

Git Diff:
{{diff}}
"""


def find_git_repo_commit_template() -> tuple[str | None, str | None]:
    """
    Discovers a commit message template from the local git repository:
    1. git config commit.template
    2. Well-known repository files (.gitmessage, .github/commit_template.md, etc.)
    Returns (prompt_template_string, source_description) or (None, None).
    """
    try:
        res = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False)
        if res.returncode != 0 or not res.stdout.strip():
            return None, None
        repo_root = res.stdout.strip()
    except Exception:
        return None, None

    # 1. Check git config commit.template
    try:
        res_cfg = subprocess.run(["git", "config", "--get", "commit.template"], capture_output=True, text=True, check=False)
        if res_cfg.returncode == 0 and res_cfg.stdout.strip():
            cfg_path = res_cfg.stdout.strip()
            full_path = os.path.expanduser(cfg_path)
            if not os.path.isabs(full_path):
                full_path = os.path.join(repo_root, full_path)
            if os.path.isfile(full_path):
                try:
                    with open(full_path, "r", encoding="utf-8", errors="replace") as f:
                        raw = f.read().strip()
                        if raw:
                            return wrap_repo_template_as_prompt(raw, f"git-config: {os.path.basename(full_path)}"), f"repo:{os.path.basename(full_path)}"
                except Exception:
                    pass
    except Exception:
        pass

    # 2. Check well-known repo template files
    candidates = [
        ".gitmessage",
        ".gitmessage.txt",
        ".gitmessage.md",
        ".commit-template",
        ".commit_template",
        ".commit-template.txt",
        os.path.join(".github", "commit-template.md"),
        os.path.join(".github", "commit_template.md"),
        os.path.join(".github", "commit-template.txt"),
        os.path.join(".github", "commit_template.txt"),
    ]

    for rel_path in candidates:
        full_path = os.path.join(repo_root, rel_path)
        if os.path.isfile(full_path):
            try:
                with open(full_path, "r", encoding="utf-8", errors="replace") as f:
                    raw = f.read().strip()
                    if raw:
                        return wrap_repo_template_as_prompt(raw, f"repo: {rel_path}"), f"repo:{rel_path}"
            except Exception:
                pass

    return None, None


def get_git_staged_files() -> list[str]:
    """Returns list of staged modified files, or unstaged if none staged."""
    try:
        res = subprocess.run(
            ["git", "diff", "--cached", "--name-only"],
            capture_output=True, text=True, check=False
        )
        if res.returncode == 0 and res.stdout.strip():
            return [f.strip() for f in res.stdout.splitlines() if f.strip()]
        res_unstaged = subprocess.run(
            ["git", "diff", "--name-only"],
            capture_output=True, text=True, check=False
        )
        if res_unstaged.returncode == 0:
            return [f.strip() for f in res_unstaged.stdout.splitlines() if f.strip()]
    except Exception:
        pass
    return []


def render_commit_template(template: str, context: dict[str, str]) -> str:
    """Safely substitutes {key} placeholders in template without raising KeyError on literal braces."""
    result = template
    for key, val in context.items():
        result = result.replace(f"{{{key}}}", str(val))
    return result


def resolve_commit_template(
    template_name_or_str: str | None,
    config: dict
) -> tuple[str, str]:
    """Resolves commit prompt template string and its identifier."""
    commit_cfg = config.get("commit", {})
    configured_templates = {**DEFAULT_COMMIT_TEMPLATES, **commit_cfg.get("templates", {})}

    # 1. Explicit CLI choice
    if template_name_or_str:
        # Check if user explicitly asked for repository template
        if template_name_or_str.lower() in ("repo", "git", "gitmessage"):
            repo_tpl, repo_src = find_git_repo_commit_template()
            if repo_tpl and repo_src:
                return repo_tpl, repo_src
            print(f"{C_YELLOW}⚠️ No commit template found in git config or repository files, falling back to default.{C_RESET}", file=sys.stderr)

        if template_name_or_str in configured_templates:
            return configured_templates[template_name_or_str], template_name_or_str
        if "{diff}" in template_name_or_str:
            return template_name_or_str, "custom-inline"
        if os.path.isfile(template_name_or_str):
            try:
                with open(template_name_or_str, "r", encoding="utf-8") as f:
                    raw = f.read().strip()
                    return wrap_repo_template_as_prompt(raw, os.path.basename(template_name_or_str)), os.path.basename(template_name_or_str)
            except Exception:
                pass
        print(f"{C_YELLOW}⚠️ Unknown template '{template_name_or_str}', falling back to default.{C_RESET}", file=sys.stderr)

    # 2. Configured default template
    default_tpl_name = commit_cfg.get("default_template", "conventional")
    if default_tpl_name in ("repo", "git", "gitmessage"):
        repo_tpl, repo_src = find_git_repo_commit_template()
        if repo_tpl and repo_src:
            return repo_tpl, repo_src

    # 3. Auto-detect repository template if enabled (default: True) and default_template is "conventional" or "auto"
    auto_detect = commit_cfg.get("auto_detect_repo_template", True)
    if auto_detect and default_tpl_name in ("conventional", "auto"):
        repo_tpl, repo_src = find_git_repo_commit_template()
        if repo_tpl and repo_src:
            return repo_tpl, repo_src

    if default_tpl_name in configured_templates:
        return configured_templates[default_tpl_name], default_tpl_name

    # 4. Legacy prompt_template property
    if "prompt_template" in commit_cfg and commit_cfg["prompt_template"]:
        return commit_cfg["prompt_template"], "config-prompt"

    # 5. Built-in conventional fallback
    return DEFAULT_COMMIT_TEMPLATES["conventional"], "conventional"


def query_llm_for_commit(
    diff_text: str,
    backend: str,
    model: str = None,
    template_str: str = None,
    template_context: dict = None,
    effort: str = "low",
    max_diff_length: int = 15000
) -> str:
    # Cap diff to prevent overflowing CLI argument limits
    if max_diff_length and len(diff_text) > max_diff_length:
        diff_text = diff_text[:max_diff_length] + "\n... [diff truncated for length]"

    context = dict(template_context or {})
    context["diff"] = diff_text
    context.setdefault("branch", "")
    context.setdefault("task_id", "")
    context.setdefault("issue_id", context.get("task_id", ""))
    context.setdefault("ticket_id", context.get("task_id", ""))
    context.setdefault("ticket", context.get("task_id", ""))
    context.setdefault("jira_id", context.get("task_id", ""))  # Backward compatibility
    context.setdefault("files", "")
    context.setdefault("model", model or "")
    context.setdefault("scope", "")

    template = template_str or DEFAULT_COMMIT_TEMPLATES["conventional"]
    prompt = render_commit_template(template, context)
    return query_llm(
        prompt=prompt,
        backend=backend,
        model=model,
        effort=effort,
        timeout_sec=45,
        clean_markdown_fence=True,
        mode="chat",
        output_format="text"
    )


def run_commit(
    stage_all: bool = False,
    backend: str = None,
    model: str = None,
    template: str = None,
    task_id: str = None,
    jira_id: str = None,
    scope: str = None,
    dry_run: bool = False,
    list_templates: bool = False,
    list_backends: bool = False
) -> None:
    if list_backends:
        show_backends()
        return

    config = load_config()
    commit_cfg = config.get("commit", {})

    configured_templates = {**DEFAULT_COMMIT_TEMPLATES, **commit_cfg.get("templates", {})}

    if list_templates:
        print(f"\n{C_BOLD}{C_CYAN}Available Commit Message Templates:{C_RESET}\n")
        default_name = commit_cfg.get("default_template", "conventional")
        repo_tpl, repo_src = find_git_repo_commit_template()
        if repo_src:
            is_active = " (active repo)" if (commit_cfg.get("auto_detect_repo_template", True) and default_name in ("conventional", "auto", "repo")) else ""
            print(f"  • {C_BOLD_WHITE}{'repo':<16}{C_RESET}{C_GREEN}{is_active:<15}{C_RESET} {C_CYAN}[{repo_src}]{C_RESET} {C_DIM}Discovered repository commit template{C_RESET}")

        for name in sorted(configured_templates.keys()):
            if name in ("jira", "jira-scope"):
                continue  # Hidden backward compatibility aliases
            is_def = " (default)" if name == default_name and not repo_src else ""
            desc = name
            if name == "conventional":
                desc = "Standard Conventional Commits (<type>(<scope>): <summary>)"
            elif name == "task":
                desc = "Task-prefixed Conventional Commits ([<TASK-ID>] <type>(<scope>): <summary>)"
            elif name == "task-scope":
                desc = "Task issue as scope (<type>(<TASK-ID>): <summary>)"
            elif name == "detailed":
                desc = "Multi-line with summary, WHAT/WHY paragraph, bullets, and ticket"
            print(f"  • {C_BOLD_WHITE}{name:<16}{C_RESET}{C_GREEN}{is_def:<15}{C_RESET} {C_DIM}{desc}{C_RESET}")
        print(f"\n{C_DIM}Select via: aitools commit --template <name|file|repo> (or configure in ~/.config/aitools/config.json){C_RESET}\n")
        return

    chosen_backend = backend or commit_cfg.get("default_backend") or config.get("default_commit_backend", "agy")
    chosen_model = model or commit_cfg.get("model")
    effort = commit_cfg.get("effort", "low")
    max_len = commit_cfg.get("max_diff_length", 15000)
    should_stage = stage_all or commit_cfg.get("default_stage_all", False)

    # Resolve git branch and Task ID
    branch = get_git_branch()
    resolved_task = task_id or jira_id or commit_cfg.get("task_id") or commit_cfg.get("jira_id") or extract_task_id(branch)
    files = ", ".join(get_git_staged_files()[:15])

    # Resolve template
    template_str, template_name = resolve_commit_template(template, config)

    context = {
        "branch": branch,
        "task_id": resolved_task,
        "issue_id": resolved_task,
        "ticket_id": resolved_task,
        "ticket": resolved_task,
        "jira_id": resolved_task,
        "files": files,
        "model": chosen_model or "",
        "scope": scope or ""
    }

    diff_text, ok = get_git_diff(stage_all=should_stage)
    if not ok or not diff_text.strip():
        print(f"{C_RED}✗ No changes to commit (working tree clean).{C_RESET}")
        return

    model_display = f" (model: {C_WHITE}{chosen_model}{C_RESET})" if chosen_model else ""
    task_display = f" [task: {C_YELLOW}{resolved_task}{C_RESET}]" if resolved_task else ""
    print(f"\n{C_BOLD}{C_CYAN}==> Generating Commit with AI backend: {C_WHITE}{chosen_backend}{C_RESET}{model_display} [template: {C_GREEN}{template_name}{C_RESET}]{task_display}...")

    try:
        commit_msg = query_llm_for_commit(
            diff_text=diff_text,
            backend=chosen_backend,
            model=chosen_model,
            template_str=template_str,
            template_context=context,
            effort=effort,
            max_diff_length=max_len
        )
    except Exception as e:
        print(f"{C_RED}[ERROR] Failed to generate commit message: {e}{C_RESET}", file=sys.stderr)
        return

    while True:
        box_w = UIBox.get_width(74)
        print(f"\n{UIBox.top(box_w, color=C_BOLD_GREEN)}")
        print(UIBox.line(f"{C_BOLD_GREEN}Proposed Commit Message:{C_RESET}", box_w, border_color=C_BOLD_GREEN))
        print(UIBox.mid(box_w, color=C_BOLD_GREEN))
        for line in commit_msg.splitlines():
            print(UIBox.line(f"{C_BOLD_WHITE}{line}{C_RESET}", box_w, border_color=C_BOLD_GREEN))
        print(f"{UIBox.bottom(box_w, color=C_BOLD_GREEN)}")

        if dry_run:
            print(f"{C_DIM}[Dry Run: not creating git commit]{C_RESET}")
            return

        print(f"  {C_YELLOW}[a]{C_RESET} Accept and commit")
        print(f"  {C_YELLOW}[e]{C_RESET} Edit message manually")
        print(f"  {C_YELLOW}[r]{C_RESET} Regenerate with AI")
        print(f"  {C_YELLOW}[c]{C_RESET} Cancel")

        choice = input(f"\n  Choose action [a/e/r/c]: ").strip().lower()

        if choice in ("a", "accept", ""):
            res = subprocess.run(["git", "commit", "-m", commit_msg])
            if res.returncode == 0:
                print(f"\n{C_GREEN}✓ Successfully committed changes!{C_RESET}\n")
            else:
                print(f"\n{C_RED}✗ Git commit failed.{C_RESET}\n")
            break

        elif choice in ("e", "edit"):
            # Open $EDITOR or input
            editor = os.getenv("EDITOR", "nvim" if shutil.which("nvim") else "nano")
            with tempfile.NamedTemporaryFile("w+", suffix=".gitcommit_msg", delete=False) as tf:
                tf.write(commit_msg)
                tmp_name = tf.name

            subprocess.run([editor, tmp_name])
            with open(tmp_name, "r", encoding="utf-8") as tf:
                commit_msg = tf.read().strip()
            os.remove(tmp_name)

            if not commit_msg:
                print(f"{C_YELLOW}Empty message entered. Aborting commit.{C_RESET}")
                break

        elif choice in ("r", "regen", "regenerate"):
            print(f"\n{C_CYAN}==> Regenerating commit message...{C_RESET}")
            try:
                commit_msg = query_llm_for_commit(
                    diff_text=diff_text,
                    backend=chosen_backend,
                    model=chosen_model,
                    template_str=template_str,
                    template_context=context,
                    effort=effort,
                    max_diff_length=max_len
                )
            except Exception as e:
                print(f"{C_RED}[ERROR] Regeneration failed: {e}{C_RESET}")

        elif choice in ("c", "cancel", "q"):
            print(f"{C_DIM}Commit cancelled by user.{C_RESET}")
            break


