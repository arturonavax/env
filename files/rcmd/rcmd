#!/usr/bin/env bash
# ==============================================================================
# rcmd - macOS rcmd-style Application Launcher & Switcher for Linux
# ==============================================================================
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_config() {
    if [ -n "${RCMD_CONFIG:-}" ] && [ -f "$RCMD_CONFIG" ]; then
        echo "$RCMD_CONFIG"
        return 0
    fi
    local xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}/rcmd/rcmd.conf"
    if [ -f "$xdg_config" ]; then
        echo "$xdg_config"
        return 0
    fi
    if [ -f "$HOME/.config/rcmd.conf" ]; then
        echo "$HOME/.config/rcmd.conf"
        return 0
    fi
    if [ -f "$SCRIPT_DIR/rcmd.conf" ]; then
        echo "$SCRIPT_DIR/rcmd.conf"
        return 0
    fi
    return 1
}

CONFIG_FILE="$(find_config 2>/dev/null || echo "")"
export CONFIG_FILE

rcmd_launch() {
    local cmd="$1"
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
    nohup bash -c "$cmd" </dev/null >/dev/null 2>&1 &
}
export -f rcmd_launch

detect_backend() {
    if [ -n "${RCMD_BACKEND:-}" ]; then
        echo "$RCMD_BACKEND"
        return 0
    fi
    local session="${XDG_SESSION_TYPE:-}"
    local desktop="${XDG_CURRENT_DESKTOP:-}"

    if [ "$session" = "wayland" ]; then
        if [[ "$desktop" =~ [Hh]yprland ]]; then
            echo "hyprland"
        elif [[ "$desktop" =~ [Ss]way ]]; then
            echo "sway"
        elif [[ "$desktop" =~ [Gg][Nn][Oo][Mm][Ee] ]]; then
            echo "gnome"
        elif [[ "$desktop" =~ [Kk][Dd][Ee] ]]; then
            echo "kwin"
        elif command -v hyprctl >/dev/null 2>&1; then
            echo "hyprland"
        elif command -v swaymsg >/dev/null 2>&1; then
            echo "sway"
        else
            echo "gnome"
        fi
    else
        echo "x11"
    fi
}

load_backend() {
    local backend="$1"
    local backend_loaded=0
    local user_lib="$HOME/.local/lib/rcmd/backends/${backend}.sh"
    local local_lib="${SCRIPT_DIR}/backends/${backend}.sh"

    if [ -f "$user_lib" ]; then
        # shellcheck source=/dev/null
        source "$user_lib"
        backend_loaded=1
    elif [ -f "$local_lib" ]; then
        # shellcheck source=/dev/null
        source "$local_lib"
        backend_loaded=1
    fi

    if [ "$backend_loaded" -eq 0 ] || ! declare -f "rcmd_backend_${backend}" >/dev/null 2>&1; then
        echo "Error: Backend '$backend' no pudo ser cargado o tiene errores de sintaxis." >&2
        exit 1
    fi
}

lookup_key_in_config() {
    local key="${1,,}"
    [ -z "$CONFIG_FILE" ] && return 1
    [ ! -f "$CONFIG_FILE" ] && return 1

    while IFS='|' read -r k cmd pat mode rest || [ -n "$k" ]; do
        k="${k//$'\r'/}"
        cmd="${cmd//$'\r'/}"
        pat="${pat//$'\r'/}"
        mode="${mode//$'\r'/}"

        k="${k#"${k%%[![:space:]]*}"}"
        k="${k%"${k##*[![:space:]]}"}"
        case "$k" in '#'*|'') continue ;; esac

        if [ "${k,,}" = "$key" ]; then
            cmd="${cmd#"${cmd%%[![:space:]]*}"}"
            cmd="${cmd%"${cmd##*[![:space:]]}"}"
            pat="${pat#"${pat%%[![:space:]]*}"}"
            pat="${pat%"${pat##*[![:space:]]}"}"
            mode="${mode#"${mode%%[![:space:]]*}"}"
            mode="${mode%"${mode##*[![:space:]]}"}"
            [ -z "$pat" ] && pat="$cmd"
            [ -z "$mode" ] && mode="class"
            echo "$cmd|$pat|$mode"
            return 0
        fi
    done < "$CONFIG_FILE"
    return 1
}

sync_xfce() {
    local rcmd_path
    rcmd_path="$(command -v rcmd || echo "$HOME/.local/bin/rcmd")"
    echo "Registrando atajos rcmd en Xfce (a-z) -> '$rcmd_path'..."
    for letter in {a..z}; do
        local prop="/commands/custom/<Primary><Shift><Super>${letter}"
        local cmd="${rcmd_path} ${letter}"
        xfconf-query -c xfce4-keyboard-shortcuts -p "$prop" -n -t string -s "$cmd"
    done
    echo "Listo. 26 atajos registrados en Xfce."
}

list_mappings() {
    if [ -z "$CONFIG_FILE" ]; then
        echo "No se encontró archivo de configuración."
        exit 0
    fi
    echo "Configuración: $CONFIG_FILE"
    echo "---------------------------------------------------------------------------------"
    printf "%-6s | %-45s | %-16s | %-6s\n" "KEY" "COMMAND" "WINDOW PATTERN" "MODE"
    echo "---------------------------------------------------------------------------------"
    while IFS='|' read -r k cmd pat mode rest || [ -n "$k" ]; do
        k="${k//$'\r'/}"
        cmd="${cmd//$'\r'/}"
        pat="${pat//$'\r'/}"
        mode="${mode//$'\r'/}"

        k="${k#"${k%%[![:space:]]*}"}"
        k="${k%"${k##*[![:space:]]}"}"
        case "$k" in '#'*|'') continue ;; esac

        cmd="${cmd#"${cmd%%[![:space:]]*}"}"
        cmd="${cmd%"${cmd##*[![:space:]]}"}"
        pat="${pat#"${pat%%[![:space:]]*}"}"
        pat="${pat%"${pat##*[![:space:]]}"}"
        mode="${mode#"${mode%%[![:space:]]*}"}"
        mode="${mode%"${mode##*[![:space:]]}"}"
        [ -z "$pat" ] && pat="$cmd"
        [ -z "$mode" ] && mode="class"
        printf "%-6s | %-45s | %-16s | %-6s\n" "$k" "$cmd" "$pat" "$mode"
    done < "$CONFIG_FILE"
    echo "---------------------------------------------------------------------------------"
}

show_status() {
    local backend
    backend="$(detect_backend)"
    echo "rcmd System Status"
    echo "--------------------------------------------------------"
    echo "Active Backend    : $backend"
    echo "Session Type      : ${XDG_SESSION_TYPE:-unknown}"
    echo "Current Desktop   : ${XDG_CURRENT_DESKTOP:-unknown}"
    echo "Config File       : ${CONFIG_FILE:-Not found (using dynamic fallback only)}"
    echo "Installed Binary  : $(command -v rcmd || echo "$SCRIPT_DIR/rcmd")"
    echo "--------------------------------------------------------"
}

show_help() {
    cat <<'EOF'
Uso: rcmd <KEY>
     rcmd <COMMAND> [PATTERN] [MODE]
     rcmd [OPCION]

Argumentos:
  <KEY>               Letra del atajo (ej: 't', 'b', 'w').
  <COMMAND> [PATTERN] [MODE]
                      Invocación directa. MODE puede ser 'class' o 'title'.

Opciones:
  --status, -s        Muestra el estado del entorno y backend
  --list, -l          Muestra los mapeos configurados
  --sync-xfce         Registra a-z en Xfce vía xfconf-query
  -h, --help          Muestra esta ayuda
EOF
}

main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    # Opciones de administración (deben evaluarse antes del lock y del backend)
    case "$1" in
        -h|--help|help) show_help; exit 0 ;;
        --status|-s)    show_status; exit 0 ;;
        --sync-xfce)    sync_xfce; exit 0 ;;
        --list|-l)      list_mappings; exit 0 ;;
    esac

    local lock_key="${1:-default}"
    lock_key="${lock_key//[^a-zA-Z0-9_-]/_}"
    local lock_file="${XDG_RUNTIME_DIR:-/tmp}/rcmd_${lock_key}.lock"
    exec 9>"$lock_file"
    if ! flock -n 9; then
        exit 0
    fi

    trap 'flock -u 9 2>/dev/null || true; exec 9>&- 2>/dev/null || true' EXIT INT TERM

    local backend
    backend="$(detect_backend)"
    load_backend "$backend"

    if [ $# -ge 2 ]; then
        local direct_cmd="$1"
        local direct_pattern="$2"
        local direct_mode="${3:-class}"
        "rcmd_backend_${backend}" "" "$direct_cmd" "$direct_pattern" "$direct_mode"
        exit 0
    fi

    local input="$1"
    local entry
    entry="$(lookup_key_in_config "$input" || echo "")"
    if [ -n "$entry" ]; then
        local cmd pat mode
        IFS='|' read -r cmd pat mode <<< "$entry"
        "rcmd_backend_${backend}" "$input" "$cmd" "$pat" "${mode:-class}"
    else
        if [ ${#input} -eq 1 ]; then
            "rcmd_backend_${backend}" "$input" "" "" "class"
        else
            "rcmd_backend_${backend}" "" "$input" "$input" "class"
        fi
    fi
}

main "$@"
