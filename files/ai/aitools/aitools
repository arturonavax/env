def strip_jsonc_comments(text: str) -> str:
    """
    Strips single-line (// and #) and multi-line (/* ... */) comments from JSONC text,
    and removes trailing commas before closing braces/brackets, while safely preserving
    strings and escaped characters.
    """
    result = []
    i = 0
    n = len(text)
    in_string = False
    escape = False

    while i < n:
        c = text[i]
        if in_string:
            result.append(c)
            if escape:
                escape = False
            elif c == "\\":
                escape = True
            elif c == '"':
                in_string = False
            i += 1
            continue

        if c == '"':
            in_string = True
            result.append(c)
            i += 1
        elif c == '/' and i + 1 < n and text[i + 1] == '/':
            i += 2
            while i < n and text[i] != '\n':
                i += 1
        elif c == '/' and i + 1 < n and text[i + 1] == '*':
            i += 2
            while i + 1 < n and not (text[i] == '*' and text[i + 1] == '/'):
                i += 1
            i += 2
        elif c == '#':
            i += 1
            while i < n and text[i] != '\n':
                i += 1
        else:
            result.append(c)
            i += 1

    clean_str = "".join(result)
    clean_str = re.sub(r',\s*([}\]])', r'\1', clean_str)
    return clean_str


def deep_merge(base: dict, override: dict) -> dict:
    """Recursively merges override dictionary into base dictionary without mutating base."""
    result = base.copy()
    for k, v in override.items():
        if k in result and isinstance(result[k], dict) and isinstance(v, dict):
            result[k] = deep_merge(result[k], v)
        else:
            result[k] = v
    return result


def load_config() -> dict:
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        repo_template = os.path.join(os.path.dirname(__file__), "config.template.jsonc")
        repo_default = os.path.join(os.path.dirname(__file__), "config.default.json")
        src_template = repo_template if os.path.exists(repo_template) else (repo_default if os.path.exists(repo_default) else None)
        if src_template:
            try:
                with open(src_template, "r", encoding="utf-8") as f:
                    raw = f.read()
                with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                    f.write(raw)
                cfg = json.loads(strip_jsonc_comments(raw))
                return deep_merge(DEFAULT_CONFIG, cfg)
            except Exception:
                pass
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG

    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            raw = f.read()
        clean = strip_jsonc_comments(raw)
        data = json.loads(clean)
        return deep_merge(DEFAULT_CONFIG, data)
    except Exception as e:
        print(f"{C_YELLOW}[WARN] Error parsing {CONFIG_FILE}: {e}. Using defaults.{C_RESET}", file=sys.stderr)
        return DEFAULT_CONFIG


def save_config(cfg: dict) -> None:
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp_path = CONFIG_FILE + f".tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp_path, CONFIG_FILE)


def load_state() -> dict:
    os.makedirs(STATE_DIR, exist_ok=True)
    default_state = {
        "scheduled_wake_epoch": 0,
        "expecting_auto_wake": False,
        "last_wake_epoch": 0,
        "targets_last_wake": {},
        "notified_resets": {},
        "history": []
    }
    if not os.path.exists(STATE_FILE):
        return default_state
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            default_state.update(data)
