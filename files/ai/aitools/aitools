        for name in sorted(configured_templates.keys()):
            is_def = " (default)" if name == default_name and not repo_src else ""
            desc = name
            if name == "standard":
                desc = "Standard PR (Summary, Key Changes, Decisions, Verification, Checklist)"
            elif name == "task":
                desc = "Task-linked PR ([TASK-ID] Title, Problem, Solution, Verification)"
            elif name == "minimal":
                desc = "Terse high-signal summary, bulleted changes and verification note"
            elif name == "detailed":
                desc = "Deep-dive architectural specification with subsystem walkthrough"
            print(f"  • {C_BOLD_WHITE}{name:<16}{C_RESET}{C_GREEN}{is_def:<15}{C_RESET} {C_DIM}{desc}{C_RESET}")
        print(f"\n{C_DIM}Select via: aitools pr --template <name|file|repo> (or configure in ~/.config/aitools/config.json){C_RESET}\n")
        return

    chosen_backend = backend or pr_cfg.get("default_backend") or config.get("default_commit_backend", "agy")
    chosen_model = model or pr_cfg.get("model")
    effort = pr_cfg.get("effort", "low")
    max_len = pr_cfg.get("max_diff_length", 25000)

    # Resolve Git context
    curr_branch = get_git_branch()
    base_branch = detect_git_base_branch(base, pr_cfg.get("default_base"))
    head_ref = head or "HEAD"
    resolved_task = task_id or pr_cfg.get("task_id") or extract_task_id(curr_branch)

    commit_lines, commits_str = get_git_branch_commits(base_branch, head_ref)
    stat_str = get_git_branch_stat(base_branch, head_ref)
    files_list = get_git_branch_files(base_branch, head_ref)
    diff_text, ok = get_git_branch_diff(base_branch, head_ref)

    if not ok or (not diff_text.strip() and not commits_str.strip()):
        print(f"{C_RED}✗ No commits or changes found between base '{base_branch}' and '{head_ref}'.{C_RESET}", file=sys.stderr)
        return

    # Resolve template
    template_str, template_name = resolve_pr_template(template, config)

    context = {
        "branch": curr_branch,
        "base": base_branch,
        "head": head_ref,
        "task_id": resolved_task or "",
        "issue_id": resolved_task or "",
        "ticket_id": resolved_task or "",
        "ticket": resolved_task or "",
        "task_ref": f"- **Related Issue / Ticket**: {resolved_task}" if resolved_task else "",
        "commits": commits_str or "(No individual commit logs)",
        "files": ", ".join(files_list[:25]) if files_list else "None",
        "stat": stat_str or "(No diff stat)",
        "model": chosen_model or "",
    }

    if not print_raw:
        model_display = f" (model: {C_WHITE}{chosen_model}{C_RESET})" if chosen_model else ""
        task_display = f" [task: {C_YELLOW}{resolved_task}{C_RESET}]" if resolved_task else ""
        print(f"\n{C_BOLD}{C_CYAN}==> Generating PR Description with AI: {C_WHITE}{chosen_backend}{C_RESET}{model_display} [{base_branch}..{curr_branch}] [template: {C_GREEN}{template_name}{C_RESET}]{task_display}...")

    try:
        pr_markdown = query_llm_for_pr(
            diff_text=diff_text,
            backend=chosen_backend,
            model=chosen_model,
            template_str=template_str,
            template_context=context,
            effort=effort,
            max_diff_length=max_len
        )
    except Exception as e:
        print(f"{C_RED}[ERROR] Failed to generate PR description: {e}{C_RESET}", file=sys.stderr)
        return

    # Fast-path for non-interactive / pipeline usage
    if print_raw:
        print(pr_markdown)
        if output_file:
            with open(output_file, "w", encoding="utf-8") as f:
                f.write(pr_markdown + "\n")
        if copy_clipboard:
            copy_to_clipboard(pr_markdown)
        return

    if output_file and dry_run:
        with open(output_file, "w", encoding="utf-8") as f:
            f.write(pr_markdown + "\n")
        print(f"{C_GREEN}✓ PR description written to: {output_file}{C_RESET}")

    if copy_clipboard and dry_run:
        if copy_to_clipboard(pr_markdown):
            print(f"{C_GREEN}✓ PR description copied to clipboard.{C_RESET}")

    # Interactive Loop
    while True:
        box_w = UIBox.get_width(84)
        print(f"\n{UIBox.top(box_w, color=C_BOLD_CYAN)}")
        print(UIBox.line(f"{C_BOLD_CYAN}Proposed Pull Request Description ({template_name}):{C_RESET}", box_w, border_color=C_BOLD_CYAN))
        print(UIBox.mid(box_w, color=C_BOLD_CYAN))
        for line in pr_markdown.splitlines():
            print(UIBox.line(f"{line}", box_w, border_color=C_BOLD_CYAN))
        print(f"{UIBox.bottom(box_w, color=C_BOLD_CYAN)}")

        if dry_run:
            print(f"{C_DIM}[Dry Run: not saving or creating PR]{C_RESET}\n")
            return

        has_gh = bool(shutil.which("gh"))
        print(f"  {C_YELLOW}[a]{C_RESET} Accept and print to stdout")
        print(f"  {C_YELLOW}[c]{C_RESET} Copy to clipboard")
        print(f"  {C_YELLOW}[s]{C_RESET} Save to file (e.g. PR_DESCRIPTION.md)")
        print(f"  {C_YELLOW}[e]{C_RESET} Edit description manually")
        print(f"  {C_YELLOW}[r]{C_RESET} Regenerate with AI")
        if has_gh:
            print(f"  {C_YELLOW}[p]{C_RESET} Create PR directly via GitHub CLI (gh pr create)")
        print(f"  {C_YELLOW}[q]{C_RESET} Quit / Cancel")

        choice = input(f"\n  Choose action: ").strip().lower()

        if choice in ("a", "accept", ""):
            print(f"\n{pr_markdown}\n")
            if output_file:
                with open(output_file, "w", encoding="utf-8") as f:
                    f.write(pr_markdown + "\n")
                print(f"{C_GREEN}✓ Written to {output_file}{C_RESET}\n")
            break

        elif choice in ("c", "copy"):
            if copy_to_clipboard(pr_markdown):
                print(f"\n{C_GREEN}✓ Successfully copied PR description to clipboard!{C_RESET}")
            else:
                print(f"\n{C_YELLOW}⚠️ Clipboard tool (wl-copy, xclip, pbcopy) not available. Output printed above.{C_RESET}")

        elif choice in ("s", "save"):
            default_out = output_file or "PR_DESCRIPTION.md"
            dest = input(f"  Save file path [{default_out}]: ").strip() or default_out
            try:
                with open(dest, "w", encoding="utf-8") as f:
                    f.write(pr_markdown + "\n")
                print(f"\n{C_GREEN}✓ PR description saved to: {dest}{C_RESET}")
            except Exception as e:
                print(f"\n{C_RED}✗ Failed to write file: {e}{C_RESET}")

        elif choice in ("e", "edit"):
            editor = os.getenv("EDITOR", "nvim" if shutil.which("nvim") else "nano")
            with tempfile.NamedTemporaryFile("w+", suffix=".pr_description.md", delete=False) as tf:
                tf.write(pr_markdown)
                tmp_name = tf.name

            subprocess.run([editor, tmp_name])
            with open(tmp_name, "r", encoding="utf-8") as tf:
                pr_markdown = tf.read().strip()
            os.remove(tmp_name)

        elif choice in ("r", "regen", "regenerate"):
            print(f"\n{C_CYAN}==> Regenerating PR description with {chosen_backend}...{C_RESET}")
            try:
                pr_markdown = query_llm_for_pr(
                    diff_text=diff_text,
                    backend=chosen_backend,
                    model=chosen_model,
                    template_str=template_str,
                    template_context=context,
                    effort=effort,
                    max_diff_length=max_len
                )
            except Exception as e:
                print(f"{C_RED}[ERROR] Regeneration failed: {e}{C_RESET}")

        elif choice in ("p", "gh") and has_gh:
            title = ""
            for line in pr_markdown.splitlines():
                clean_l = line.lstrip("#").strip()
                if clean_l:
                    title = clean_l
                    break
            if not title:
                title = f"feat: updates from {curr_branch}"

            gh_title = input(f"  PR Title [{title}]: ").strip() or title
            with tempfile.NamedTemporaryFile("w+", suffix=".pr_body.md", delete=False) as tf:
                tf.write(pr_markdown)
                body_path = tf.name

            cmd = ["gh", "pr", "create", "--base", base_branch, "--title", gh_title, "--body-file", body_path]
            res = subprocess.run(cmd)
            os.remove(body_path)
            if res.returncode == 0:
                print(f"\n{C_GREEN}✓ Pull Request created successfully via GitHub CLI!{C_RESET}\n")
                break
            else:
                print(f"\n{C_RED}✗ 'gh pr create' exited with code {res.returncode}.{C_RESET}")

        elif choice in ("q", "quit", "cancel"):
            print(f"{C_DIM}PR generation cancelled.{C_RESET}")
            break


