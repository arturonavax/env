def fetch_agy_usage(status_cmd: list) -> dict:
    cmd = status_cmd or ["agy", "-p", "/usage", "--output-format", "json"]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        if res.returncode == 0 and res.stdout.strip():
            parsed = json.loads(res.stdout)
            cmd_data = parsed.get("command", {}).get("data", {})
            if cmd_data:
                return cmd_data
    except Exception:
        pass

    # Fallback to plain text agy /usage
    try:
        res = subprocess.run(["agy", "-p", "/usage"], capture_output=True, text=True, timeout=15)
        if res.returncode == 0 and res.stdout.strip():
            groups = []
            for line in res.stdout.strip().splitlines():
                parts = re.split(r'\s{2,}|\t', line.strip())
                if len(parts) >= 3:
                    g_name, b_name, rem_pct = parts[0], parts[1], parts[2]
                    reset_str = parts[3] if len(parts) > 3 else ""
                    b_id = "gemini-5h" if "Five" in b_name and "Gemini" in g_name else "3p-5h"
                    rem_frac = float(rem_pct.replace("%", "").strip()) / 100.0 if "%" in rem_pct else 1.0
                    groups.append({
                        "name": g_name,
                        "buckets": [{
                            "id": b_id,
                            "name": b_name,
                            "remaining_fraction": rem_frac,
                            "reset_time": reset_str
                        }]
                    })
            return {"groups": groups}
    except Exception:
        pass

    return {}


def evaluate_target(target: dict, state: dict, now_utc: datetime) -> dict:
    t_id = target.get("id")
    t_name = target.get("name", t_id)
    t_type = target.get("telemetry_type", "timed_fallback")
    t_tool = target.get("tool", "unknown")
    t_account = target.get("account", "default")
    bucket_id = target.get("bucket_id")
    fallback_hours = target.get("fallback_interval_hours", 5)

    info = {
        "id": t_id,
        "name": t_name,
        "tool": t_tool,
        "account": t_account,
        "enabled": target.get("enabled", True),
        "telemetry_type": t_type,
        "remaining_percent": 100.0,
        "remaining_seconds": 0,
        "reset_time_local": "-",
        "is_active": False,
        "status_label": "IDLE (ready to prime)",
        "needs_wake": False
    }

    if not info["enabled"]:
        info["status_label"] = "DISABLED"
        return info

    if t_type == "agy_usage":
        usage = fetch_agy_usage(target.get("status_command", []))
        bucket = None
        for group in usage.get("groups", []):
            for b in group.get("buckets", []):
                if b.get("id") == bucket_id:
                    bucket = b
                    break
            if bucket:
                break

        if bucket:
            r_frac = float(bucket.get("remaining_fraction", 1.0))
            r_time_str = bucket.get("reset_time")
            info["remaining_percent"] = round(r_frac * 100.0, 1)

            if r_time_str:
                try:
                    if "T" in r_time_str and "Z" in r_time_str:
                        r_dt = datetime.fromisoformat(r_time_str.replace("Z", "+00:00"))
                    else:
                        clean_str = re.sub(r'\s*-\d{2}$', '', r_time_str.strip())
                        r_dt = datetime.strptime(clean_str, "%Y-%m-%d %H:%M").replace(tzinfo=timezone.utc)

                    local_dt = r_dt.astimezone()
                    info["reset_time_local"] = local_dt.strftime("%H:%M:%S")

                    if r_dt > now_utc:
                        info["is_active"] = True
                        diff_sec = (r_dt - now_utc).total_seconds()
                        info["remaining_seconds"] = int(diff_sec)
                        h = int(diff_sec // 3600)
                        m = int((diff_sec % 3600) // 60)
                        info["status_label"] = f"ACTIVE ({h}h {m:02d}m left, resets at {local_dt.strftime('%H:%M')})"
                        info["needs_wake"] = False
                    else:
                        info["is_active"] = False
                        info["status_label"] = f"EXPIRED (Refreshed at {local_dt.strftime('%H:%M')})"
                        info["needs_wake"] = True
                except Exception:
                    info["status_label"] = f"PARSE_ERR ({r_time_str})"
                    info["needs_wake"] = True
            else:
                info["status_label"] = "IDLE (no rolling timer active)"
                info["needs_wake"] = True
        else:
            info["status_label"] = "TELEMETRY_UNAVAILABLE"
            info["needs_wake"] = True

    elif t_type == "claude_status":
        cmd = target.get("status_command", ["claude", "status", "--json"])
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            if res.returncode == 0 and res.stdout.strip():
                data = json.loads(res.stdout)
                # Claude status JSON parsing if present
                rem = data.get("remaining_percent", 100.0)
                info["remaining_percent"] = float(rem)
                info["status_label"] = "AVAILABLE"
                info["needs_wake"] = False
            else:
                info["status_label"] = "IDLE (claude status ok)"
                info["needs_wake"] = True
        except Exception:
            info["status_label"] = "TIMED_FALLBACK"
            t_type = "timed_fallback"

    if t_type == "timed_fallback" or not info.get("status_label") or info["status_label"] in ("TELEMETRY_UNAVAILABLE", "TIMED_FALLBACK"):
        # Fallback countdown based on last_wake_epoch
        targets_last_wake = state.get("targets_last_wake", {})
        last_wake = targets_last_wake.get(t_id, 0)
        now_epoch = now_utc.timestamp()
        window_sec = fallback_hours * 3600
        elapsed = now_epoch - last_wake

        if last_wake > 0 and elapsed < window_sec:
            rem_sec = int(window_sec - elapsed)
            info["is_active"] = True
            info["remaining_seconds"] = rem_sec
            h = rem_sec // 3600
            m = (rem_sec % 3600) // 60
            reset_dt = datetime.fromtimestamp(last_wake + window_sec).astimezone()
            info["reset_time_local"] = reset_dt.strftime("%H:%M:%S")
            info["status_label"] = f"COUNTDOWN ({h}h {m:02d}m left, fallback ~{reset_dt.strftime('%H:%M')})"
            info["needs_wake"] = False
        else:
            info["is_active"] = False
            info["status_label"] = "IDLE (countdown expired or unprimed)"
            info["needs_wake"] = True

    return info


def evaluate_all_targets(config: dict, state: dict) -> list[dict]:
    now_utc = datetime.now(timezone.utc)
    return [evaluate_target(t, state, now_utc) for t in config.get("targets", [])]


