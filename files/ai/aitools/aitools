def main() -> None:
    # Fast-path: Check for direct custom command invocation (e.g. `aitools review`)
    known_subcommands = {
        "quota", "watch", "wake", "commit", "backends", "daemon", "status",
        "config", "run", "commands", "-v", "--version", "-h", "--help"
    }

    if len(sys.argv) > 1 and sys.argv[1] not in known_subcommands and not sys.argv[1].startswith("-"):
        cfg = load_config()
        custom_cmds = cfg.get("commands", {})
        cand = sys.argv[1]
        if cand in custom_cmds:
            execute_custom_command(cand, custom_cmds[cand], sys.argv[2:])
            return

    parser = argparse.ArgumentParser(
        prog="aitools",
        description="aitools: AI Productivity, Quota Management & Automated Workflows Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # 1. Quota
    p_quota = subparsers.add_parser("quota", help="Inspect model quota windows, remaining percentage, and reset times")
    p_quota.add_argument("--json", action="store_true", help="Output telemetry in JSON format")
    p_quota.add_argument("-t", "--target", help="Filter by target ID")

    # 2. Watch
    p_watch = subparsers.add_parser("watch", help="Live-updating TUI dashboard for AI quotas and timers")
    p_watch.add_argument("-i", "--interval", type=int, default=30, help="Refresh interval in seconds (default: 30)")
    p_watch.add_argument("-t", "--target", help="Filter by target ID")

    # 3. Wake
    p_wake = subparsers.add_parser("wake", help="Evaluate models and trigger wakeup probes for expired/idle quotas")
    p_wake.add_argument("-f", "--force", action="store_true", help="Force wake probe even if window is currently active")
    p_wake.add_argument("-t", "--target", help="Filter by target ID")

    # 4. Commit
    p_commit = subparsers.add_parser("commit", help="Generate Conventional Git Commit messages from diff using AI")
    p_commit.add_argument("-a", "--all", action="store_true", help="Stage all tracked modified files before diffing")
    p_commit.add_argument("-b", "--backend", help="AI CLI backend (agy, claude, codex, llm, opencode, pi, ollama, or custom harness)")
    p_commit.add_argument("-m", "--model", help="Model override (e.g. gemini-2.5-flash, claude-3-7-sonnet)")
    p_commit.add_argument("-t", "--template", help="Commit prompt template name (conventional, jira, jira-scope, detailed) or custom template string")
    p_commit.add_argument("-j", "--jira", help="Jira / Issue ticket ID override (e.g. PROJ-1234)")
    p_commit.add_argument("-s", "--scope", help="Optional commit scope override")
    p_commit.add_argument("--list-templates", action="store_true", help="List all available commit templates")
    p_commit.add_argument("--list-backends", action="store_true", help="List all available AI CLI harnesses and strategies")
    p_commit.add_argument("-d", "--dry-run", action="store_true", help="Preview message without committing")

    # 5. Backends
    subparsers.add_parser("backends", help="List all available AI CLI harnesses and execution strategies")

    # 6. Daemon
    p_daemon = subparsers.add_parser("daemon", help="Manage background wakeup daemon, RTC alarms, and suspension")
    p_daemon.add_argument("daemon_action", choices=["status", "install", "uninstall", "run-wake-cycle", "auto-wake"])
    p_daemon.add_argument("extra_arg", nargs="?", default="", help="Optional parameter for daemon action (e.g. on/off)")

    # 7. Status
    subparsers.add_parser("status", help="Check availability and paths of AI tools and runtimes")

    # 8. Config
    p_config = subparsers.add_parser("config", help="Show, edit, or locate configuration file")
    p_config.add_argument("config_action", choices=["show", "path", "init"], default="show", nargs="?")

    # 9. Run (Declarative Custom Command)
    p_run = subparsers.add_parser("run", help="Execute a custom declarative AI command/pipeline")
    p_run.add_argument("command_name", help="Name of custom command defined in ~/.config/aitools/config.json")
    p_run.add_argument("args", nargs=argparse.REMAINDER, help="Arguments passed to custom command")

    # 10. Commands (List all built-in and declarative custom commands)
    subparsers.add_parser("commands", help="List all built-in and declarative custom AI commands")

    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    if args.subcommand == "quota":
        show_quota(as_json=args.json, target_filter=args.target)
    elif args.subcommand == "watch":
        run_watch(interval_sec=args.interval, target_filter=args.target)
    elif args.subcommand == "wake":
        run_wake(force=args.force, target_filter=args.target)
    elif args.subcommand == "commit":
        run_commit(
            stage_all=args.all,
            backend=args.backend,
            model=args.model,
            template=args.template,
            jira_id=args.jira,
            scope=args.scope,
            dry_run=args.dry_run,
            list_templates=args.list_templates,
            list_backends=args.list_backends
        )
    elif args.subcommand == "backends":
        show_backends()
    elif args.subcommand == "daemon":
        handle_daemon_cli(args)
    elif args.subcommand == "status":
        show_status()
    elif args.subcommand == "run":
        cfg = load_config()
        custom_cmds = cfg.get("commands", {})
        cmd_name = args.command_name
        if cmd_name not in custom_cmds:
            print(f"{C_RED}[ERROR] Unknown custom command '{cmd_name}'. Available commands:{C_RESET}", file=sys.stderr)
            for c in custom_cmds:
                print(f"  - {c}", file=sys.stderr)
            sys.exit(1)
        execute_custom_command(cmd_name, custom_cmds[cmd_name], args.args)
    elif args.subcommand == "commands":
        show_commands()
    elif args.subcommand == "config":
        if args.config_action == "path":
            print(CONFIG_FILE)
        elif args.config_action == "init":
            repo_template = os.path.join(os.path.dirname(__file__), "config.template.jsonc")
            repo_default = os.path.join(os.path.dirname(__file__), "config.default.json")
            if os.path.exists(repo_template):
                with open(repo_template, "r", encoding="utf-8") as f:
                    content = f.read()
                with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                    f.write(content)
            elif os.path.exists(repo_default):
                with open(repo_default, "r", encoding="utf-8") as f:
                    content = f.read()
                with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                    f.write(content)
            else:
                save_config(DEFAULT_CONFIG)
            print(f"{C_GREEN}✓ Configuration initialized at {CONFIG_FILE}{C_RESET}")
        else:
            if os.path.exists(CONFIG_FILE):
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    print(f.read().strip())
            else:
                cfg = load_config()
                print(json.dumps(cfg, indent=2))


if __name__ == "__main__":
    main()
