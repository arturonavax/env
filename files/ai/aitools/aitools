def main() -> None:
    parser = argparse.ArgumentParser(
        prog="aitools",
        description="aitools: AI Productivity, Quota Management & Automated Workflows Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # 1. Quota
    p_quota = subparsers.add_parser("quota", help="Inspect model quota windows, remaining percentage, and reset times")
    p_quota.add_argument("--json", action="store_true", help="Output telemetry in JSON format")
    p_quota.add_argument("-t", "--target", help="Filter by target ID")

    # 2. Watch
    p_watch = subparsers.add_parser("watch", help="Live-updating TUI dashboard for AI quotas and timers")
    p_watch.add_argument("-i", "--interval", type=int, default=30, help="Refresh interval in seconds (default: 30)")
    p_watch.add_argument("-t", "--target", help="Filter by target ID")

    # 3. Wake
    p_wake = subparsers.add_parser("wake", help="Evaluate models and trigger wakeup probes for expired/idle quotas")
    p_wake.add_argument("-f", "--force", action="store_true", help="Force wake probe even if window is currently active")
    p_wake.add_argument("-t", "--target", help="Filter by target ID")

    # 4. Commit
    p_commit = subparsers.add_parser("commit", help="Generate Conventional Git Commit messages from diff using AI")
    p_commit.add_argument("-a", "--all", action="store_true", help="Stage all tracked modified files before diffing")
    p_commit.add_argument("-b", "--backend", help="AI CLI backend (agy, claude, codex, llm, opencode, pi)")
    p_commit.add_argument("-m", "--model", help="Model override")
    p_commit.add_argument("-d", "--dry-run", action="store_true", help="Preview message without committing")

    # 5. Daemon
    p_daemon = subparsers.add_parser("daemon", help="Manage background wakeup daemon, RTC alarms, and suspension")
    p_daemon.add_argument("daemon_action", choices=["status", "install", "uninstall", "run-wake-cycle", "auto-wake"])
    p_daemon.add_argument("extra_arg", nargs="?", default="", help="Optional parameter for daemon action (e.g. on/off)")

    # 6. Status
    subparsers.add_parser("status", help="Check availability and paths of AI tools and runtimes")

    # 7. Config
    p_config = subparsers.add_parser("config", help="Show, edit, or locate configuration file")
    p_config.add_argument("config_action", choices=["show", "path", "init"], default="show", nargs="?")

    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    if args.subcommand == "quota":
        show_quota(as_json=args.json, target_filter=args.target)
    elif args.subcommand == "watch":
        run_watch(interval_sec=args.interval, target_filter=args.target)
    elif args.subcommand == "wake":
        run_wake(force=args.force, target_filter=args.target)
    elif args.subcommand == "commit":
        run_commit(stage_all=args.all, backend=args.backend, model=args.model, dry_run=args.dry_run)
    elif args.subcommand == "daemon":
        handle_daemon_cli(args)
    elif args.subcommand == "status":
        show_status()
    elif args.subcommand == "config":
        if args.config_action == "path":
            print(CONFIG_FILE)
        elif args.config_action == "init":
            save_config(DEFAULT_CONFIG)
            print(f"{C_GREEN}✓ Configuration initialized at {CONFIG_FILE}{C_RESET}")
        else:
            cfg = load_config()
            print(json.dumps(cfg, indent=2))


if __name__ == "__main__":
    main()
