def format_progress_bar(percent: float, width: int = 12) -> str:
    filled = int(round((percent / 100.0) * width))
    filled = max(0, min(width, filled))
    empty = width - filled
    bar = "█" * filled + "░" * empty
    if percent > 50:
        col = C_GREEN
    elif percent > 20:
        col = C_YELLOW
    else:
        col = C_RED
    return f"{col}{bar}{C_RESET} {percent:5.1f}%"


def show_quota(as_json: bool = False, target_filter: str = None) -> None:
    config = load_config()
    state = load_state()
    targets = evaluate_all_targets(config, state)

    if target_filter:
        targets = [t for t in targets if t["id"] == target_filter]

    if as_json:
        print(json.dumps(targets, indent=2))
        return

    print(f"\n{C_BOLD}{C_BLUE}╭──────────────────────────────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_BOLD}{C_BLUE}│{C_RESET}  {C_BOLD_WHITE}{'aitools · AI Models Quota & Reset Timers':<62}{C_RESET}  {C_BOLD_BLUE}│{C_RESET}")
    print(f"{C_BOLD}{C_BLUE}├──────────────────────────────────────────────────────────────────────────────────┤{C_RESET}")
    print(f"  {C_BOLD}{'ID':<16} {'TOOL':<8} {'ACCOUNT':<10} {'QUOTA':<20} {'RESETS AT':<10} {'STATUS'}{C_RESET}")
    print(f"  {C_GRAY}{'─'*16} {'─'*8} {'─'*10} {'─'*20} {'─'*10} {'─'*24}{C_RESET}")

    for t in targets:
        if not t["enabled"]:
            status_badge = f"{C_GRAY}DISABLED{C_RESET}"
        elif t["is_active"]:
            status_badge = f"{C_GREEN}ACTIVE{C_RESET} ({t['remaining_seconds']//3600}h {(t['remaining_seconds']%3600)//60:02d}m)"
        elif t["needs_wake"]:
            status_badge = f"{C_YELLOW}EXPIRED / READY{C_RESET}"
        else:
            status_badge = f"{C_CYAN}IDLE{C_RESET}"

        bar = format_progress_bar(t["remaining_percent"]) if t["enabled"] else f"{C_GRAY}─{C_RESET}"
        print(f"  {C_WHITE}{t['id']:<16}{C_RESET} {t['tool']:<8} {t['account']:<10} {bar:<29} {t['reset_time_local']:<10} {status_badge}")

    print(f"{C_BOLD}{C_BLUE}╰──────────────────────────────────────────────────────────────────────────────────╯{C_RESET}\n")


def run_watch(interval_sec: int = 30, target_filter: str = None) -> None:
    signal.signal(signal.SIGINT, lambda s, f: sys.exit(0))
    print("\033[?25l", end="", flush=True)  # Hide cursor
    try:
        while True:
            # Clear screen
            print("\033[2J\033[H", end="", flush=True)
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            print(f"{C_BOLD}{C_CYAN}aitools watch · Live Quota Monitor{C_RESET} {C_DIM}(Interval: {interval_sec}s · Press Ctrl+C to exit){C_RESET}")
            print(f"{C_DIM}Last refreshed: {now_str}{C_RESET}")
            show_quota(as_json=False, target_filter=target_filter)
            time.sleep(interval_sec)
    finally:
        print("\033[?25h", end="", flush=True)  # Restore cursor


