def wrap_repo_pr_template_as_prompt(raw_template: str, source_desc: str) -> str:
    """Wraps a repository-level Pull Request template into an LLM instruction prompt."""
    if "{diff}" in raw_template and ("{commits}" in raw_template or "{branch}" in raw_template):
        return raw_template
    return f"""You are an expert developer and technical lead writing a Pull Request (PR) description in GitHub Flavored Markdown.
Analyze the following branch commits, changed files, and git diff. Fill out the repository's official Pull Request template ({source_desc}) completely, accurately, and professionally.

Context:
- Current Branch: {{branch}}
- Target Base Branch: {{base}}
- Task / Issue ID: {{task_id}}
- Commits on Branch:
{{commits}}
- Modified Files:
{{files}}
- Diff Summary:
{{stat}}

Repository Official PR Template:
--------------------------------------------------------------------------------
{raw_template.strip()}
--------------------------------------------------------------------------------

Instructions:
1. Maintain every section, heading, and table from the repository template above.
2. Fill in all details thoroughly based on the branch changes, commits, and diff.
3. Check relevant checklist boxes with `[x]` (and leave non-applicable ones with `[ ]` or explain).
4. If a Task or Issue ID is provided ({{task_id}}), reference it in the appropriate issue/ticket field or write "Closes {{task_id}}" or "Fixes {{task_id}}".
5. For sections that do not apply to this specific change, write "N/A" or a brief explanation rather than omitting the section.
6. Write in clean, professional English.
7. Do NOT wrap the entire response in a top-level ```markdown fence. Output ONLY the filled-in Pull Request Markdown body.

Git Branch Diff:
{{diff}}
"""


def find_git_repo_pr_template() -> tuple[Optional[str], Optional[str]]:
    """
    Discovers a Pull Request (or Merge Request) template from the local git repository:
    1. .github/pull_request_template.md or .github/PULL_REQUEST_TEMPLATE.md
    2. .github/PULL_REQUEST_TEMPLATE/ (default or first .md)
    3. Root pull_request_template.md / PULL_REQUEST_TEMPLATE.md
    4. .gitlab/merge_request_templates/ (default or first .md)
    5. docs/pull_request_template.md
    Returns (prompt_template_string, source_description) or (None, None).
    """
    try:
        res = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False)
        if res.returncode != 0 or not res.stdout.strip():
            return None, None
        repo_root = res.stdout.strip()
    except Exception:
        return None, None

    candidates = [
        os.path.join(".github", "pull_request_template.md"),
        os.path.join(".github", "PULL_REQUEST_TEMPLATE.md"),
        os.path.join(".github", "PULL_REQUEST_TEMPLATE", "pull_request_template.md"),
        os.path.join(".github", "PULL_REQUEST_TEMPLATE", "default.md"),
        "pull_request_template.md",
        "PULL_REQUEST_TEMPLATE.md",
        os.path.join(".gitlab", "merge_request_templates", "default.md"),
        os.path.join(".gitlab", "merge_request_templates", "pull_request_template.md"),
        os.path.join("docs", "pull_request_template.md"),
        os.path.join("docs", "PULL_REQUEST_TEMPLATE.md"),
    ]

    for rel_path in candidates:
        full_path = os.path.join(repo_root, rel_path)
        if os.path.isfile(full_path):
            try:
                with open(full_path, "r", encoding="utf-8", errors="replace") as f:
                    raw = f.read().strip()
                    if raw:
                        return wrap_repo_pr_template_as_prompt(raw, f"repo: {rel_path}"), f"repo:{rel_path}"
            except Exception:
                pass

    dir_candidates = [
        os.path.join(repo_root, ".github", "PULL_REQUEST_TEMPLATE"),
        os.path.join(repo_root, ".github", "pull_request_template"),
        os.path.join(repo_root, ".gitlab", "merge_request_templates"),
    ]
    for d in dir_candidates:
        if os.path.isdir(d):
            try:
                files = sorted(os.listdir(d))
                for fname in files:
                    if fname.endswith((".md", ".txt")) and not fname.startswith("."):
                        fpath = os.path.join(d, fname)
                        if os.path.isfile(fpath):
                            with open(fpath, "r", encoding="utf-8", errors="replace") as f:
                                raw = f.read().strip()
                                if raw:
                                    rel = os.path.relpath(fpath, repo_root)
                                    return wrap_repo_pr_template_as_prompt(raw, f"repo: {rel}"), f"repo:{rel}"
            except Exception:
                pass

    return None, None


def detect_git_base_branch(explicit_base: Optional[str] = None, default_from_cfg: Optional[str] = None) -> str:
    """
    Detects target base branch for Pull Request comparison:
    1. Explicit CLI argument (--base / -B)
    2. Config default (pr.default_base)
    3. Auto-detection:
       - If on feature branch: checks origin/main, main, origin/master, master, origin/develop, develop
       - If on main/master: checks @{upstream} (e.g. origin/main) to show unpushed branch commits
    """
    if explicit_base:
        return explicit_base
    if default_from_cfg:
        return default_from_cfg

    curr_branch = get_git_branch()

    # If currently on main or master, compare against its upstream remote tracking branch
    if curr_branch in ("main", "master"):
        try:
            res = subprocess.run(
                ["git", "rev-parse", "--abbrev-ref", "@{upstream}"],
                capture_output=True, text=True, check=False
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
        except Exception:
            pass

    # Check candidates for feature branches
    for candidate in ("main", "master", "develop", "dev"):
        if candidate == curr_branch:
            continue
        # Check origin ref first for fresh base
        res_remote = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{candidate}"],
            capture_output=True, text=True, check=False
        )
        if res_remote.returncode == 0:
            return f"origin/{candidate}"

        # Check local ref
        res_local = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", f"refs/heads/{candidate}"],
            capture_output=True, text=True, check=False
        )
        if res_local.returncode == 0:
            return candidate

    return "main" if curr_branch != "main" else "origin/main"


def get_git_branch_commits(base_branch: str, head_ref: str = "HEAD") -> tuple[list[str], str]:
    """Returns list of commit message summaries and multiline string of commits on this branch."""
    try:
        res = subprocess.run(
            ["git", "log", "--no-merges", "--format=- %s (%h)", f"{base_branch}..{head_ref}"],
            capture_output=True, text=True, check=False
        )
        if res.returncode == 0:
            lines = [l.strip() for l in res.stdout.splitlines() if l.strip()]
            return lines, "\n".join(lines)
    except Exception:
        pass
    return [], ""


def get_git_branch_stat(base_branch: str, head_ref: str = "HEAD") -> str:
    """Returns git diff --stat between base and head."""
    try:
        res = subprocess.run(
            ["git", "diff", "--stat", f"{base_branch}...{head_ref}"],
            capture_output=True, text=True, check=False
        )
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return ""


def get_git_branch_files(base_branch: str, head_ref: str = "HEAD") -> list[str]:
    """Returns list of files modified between base and head."""
    try:
        res = subprocess.run(
            ["git", "diff", "--name-only", f"{base_branch}...{head_ref}"],
            capture_output=True, text=True, check=False
        )
        if res.returncode == 0:
            return [f.strip() for f in res.stdout.splitlines() if f.strip()]
    except Exception:
        pass
    return []


def get_git_branch_diff(base_branch: str, head_ref: str = "HEAD") -> tuple[str, bool]:
    """Returns full git diff between base and head (using three-dot comparison)."""
    try:
        res = subprocess.run(
            ["git", "diff", f"{base_branch}...{head_ref}"],
            capture_output=True, text=True, check=False
        )
        if res.returncode == 0:
            return res.stdout, True
        return "", False
    except Exception as e:
        return str(e), False


def render_pr_template(template: str, context: dict[str, Any]) -> str:
    """Safely substitutes {key} placeholders in PR template without KeyError on literal braces."""
    result = template
    for key, val in context.items():
        result = result.replace(f"{{{key}}}", str(val))
    return result


def resolve_pr_template(
    template_name_or_str: Optional[str],
    config: dict
) -> tuple[str, str]:
    """
    Resolves Pull Request prompt template string and its source identifier.
    Prioritizes repository PR template when auto_detect_repo_template is true (default).
    """
    pr_cfg = config.get("pr", {})
    configured_templates = {**DEFAULT_PR_TEMPLATES, **pr_cfg.get("templates", {})}

    # 1. Explicit CLI choice
    if template_name_or_str:
        if template_name_or_str.lower() in ("repo", "git", "github", "pr_template"):
            repo_tpl, repo_src = find_git_repo_pr_template()
            if repo_tpl and repo_src:
                return repo_tpl, repo_src
            print(f"{C_YELLOW}⚠️ No PR template found in repository files, falling back to default.{C_RESET}", file=sys.stderr)

        if template_name_or_str in configured_templates:
            return configured_templates[template_name_or_str], template_name_or_str
        if "{diff}" in template_name_or_str and ("{commits}" in template_name_or_str or "{branch}" in template_name_or_str):
            return template_name_or_str, "custom-inline"
        if os.path.isfile(template_name_or_str):
            try:
                with open(template_name_or_str, "r", encoding="utf-8") as f:
                    raw = f.read().strip()
                    return wrap_repo_pr_template_as_prompt(raw, os.path.basename(template_name_or_str)), os.path.basename(template_name_or_str)
            except Exception:
                pass
        print(f"{C_YELLOW}⚠️ Unknown PR template '{template_name_or_str}', falling back to default.{C_RESET}", file=sys.stderr)

    # 2. Prioritize repository template if enabled (default: True)
    auto_detect = pr_cfg.get("auto_detect_repo_template", True)
    default_tpl_name = pr_cfg.get("default_template", "standard")

    if auto_detect:
        repo_tpl, repo_src = find_git_repo_pr_template()
        if repo_tpl and repo_src:
            return repo_tpl, repo_src

    # 3. Configured default template
    if default_tpl_name in configured_templates:
        return configured_templates[default_tpl_name], default_tpl_name

    # 4. Standard fallback
    return DEFAULT_PR_TEMPLATES["standard"], "standard"


def query_llm_for_pr(
    diff_text: str,
    backend: str,
    model: Optional[str] = None,
    template_str: Optional[str] = None,
    template_context: Optional[dict] = None,
    effort: str = "low",
