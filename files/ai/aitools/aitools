def load_config() -> dict:
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        # Look for default template in repo files if available
        repo_default = os.path.join(os.path.dirname(__file__), "config.default.json")
        if os.path.exists(repo_default):
            try:
                with open(repo_default, "r", encoding="utf-8") as f:
                    cfg = json.load(f)
                save_config(cfg)
                return cfg
            except Exception:
                pass
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG

    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            merged = DEFAULT_CONFIG.copy()
            merged.update(data)
            return merged
    except Exception as e:
        print(f"{C_YELLOW}[WARN] Error parsing {CONFIG_FILE}: {e}. Using defaults.{C_RESET}", file=sys.stderr)
        return DEFAULT_CONFIG


def save_config(cfg: dict) -> None:
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp_path = CONFIG_FILE + f".tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp_path, CONFIG_FILE)


def load_state() -> dict:
    os.makedirs(STATE_DIR, exist_ok=True)
    default_state = {
        "scheduled_wake_epoch": 0,
        "expecting_auto_wake": False,
        "last_wake_epoch": 0,
        "targets_last_wake": {},
        "notified_resets": {},
        "history": []
    }
    if not os.path.exists(STATE_FILE):
        return default_state
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            default_state.update(data)
            return default_state
    except Exception:
        return default_state


def save_state(st: dict) -> None:
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp_path = STATE_FILE + f".tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2)
    os.replace(tmp_path, STATE_FILE)


