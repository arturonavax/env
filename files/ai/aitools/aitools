) -> None:
    """Generates Pull Request Markdown description from branch diff and commit log using AI."""
    if list_backends:
        show_backends()
        return

    config = load_config()
    pr_cfg = config.get("pr", {})
    configured_templates = {**DEFAULT_PR_TEMPLATES, **pr_cfg.get("templates", {})}

    if list_templates:
